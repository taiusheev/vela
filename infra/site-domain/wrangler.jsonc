{
  "name": "vela-website",
  "main": "worker.mjs",
  "account_id": "36c483ebea452f45cb3e568f726d044a",
  "compatibility_date": "2026-10-10",
  // Per-visitor limits on the two writes (worker.mjs). Sign-ups: 5 a minute from one address is
  // more than a person retrying ever needs. Usage events: the page sends a few per visit.
  "ratelimits": [
    { "name": "WAITLIST_LIMIT", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } },
    { "name": "ANALYTICS_LIMIT", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [
    { "pattern": "vela-light.com", "custom_domain": true },
    { "pattern": "www.vela-light.com", "custom_domain": true }
  ]
}
