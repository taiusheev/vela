ngLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="291" width="120" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Register-preserving; original shown alongside" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="291" width="410" height="26" as="geometry"/></mxCell><mxCell id="c33" value="prompt" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="317" width="130" height="26" as="geometry"/></mxCell><mxCell id="c34" value="recent mentions; family dates; contributor's last item" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="317" width="330" height="26" as="geometry"/></mxCell><mxCell id="c35" value="one sentence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="317" width="330" height="26" as="geometry"/></mxCell><mxCell id="c36" value="Claude, effort low" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="317" width="120" height="26" as="geometry"/></mxCell><mxCell id="c37" value="Suggestion only; nothing auto-sent as a person" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="317" width="410" height="26" as="geometry"/></mxCell><mxCell id="c38" value="fallback" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="343" width="130" height="26" as="geometry"/></mxCell><mxCell id="c39" value="yesterday's summary; weather; address form" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="343" width="330" height="26" as="geometry"/></mxCell><mxCell id="c40" value="two lines" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="343" width="330" height="26" as="geometry"/></mxCell><mxCell id="c41" value="Claude, effort low" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="343" width="120" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Always signed “Vela, from your family”; never pretends to be family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="343" width="410" height="26" as="geometry"/></mxCell><mxCell id="c43" value="weekly_read" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="369" width="130" height="36" as="geometry"/></mxCell><mxCell id="c44" value="7 days of summaries; timing stats; mentions" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="369" width="330" height="36" as="geometry"/></mxCell><mxCell id="c45" value="3–5 lines + one suggestion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="369" width="330" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Claude, effort medium" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="369" width="120" height="36" as="geometry"/></mxCell><mxCell id="c47" value="“Later than usual”, never “concerning”; one suggestion at most" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="369" width="410" height="36" as="geometry"/></mxCell><mxCell id="c48" value="drift (phase 3)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="130" height="26" as="geometry"/></mxCell><mxCell id="c49" value="21 days of stats" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="405" width="330" height="26" as="geometry"/></mxCell><mxCell id="c50" value="signals[] with confidence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="405" width="330" height="26" as="geometry"/></mxCell><mxCell id="c51" value="model + rules" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="405" width="120" height="26" as="geometry"/></mxCell><mxCell id="c52" value="Conservative; “worth a call”; precision published" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="405" width="410" height="26" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Prompt registry and evaluation&lt;/b&gt;&lt;br&gt;• Each call has a versioned system prompt (ai/prompts/&lt;name&gt;.v&lt;N&gt;.md); the version is stored on every log row&lt;br&gt;• Structured outputs via JSON schema (Zod); parse failures fall back to a safe default (no flag, summary “answered”)&lt;br&gt;• Held-out set of real, consented, anonymised answers, hand-labelled for summary quality, flag correctness, away detection; runs on every prompt change; flag recall must not drop&lt;br&gt;• Quiet-notice precision comes from quiet_events.outcome, not from the model" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="451" width="430" height="170" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Cost&lt;/b&gt;&lt;br&gt;• Per kept-light member per day: ~1 understand (≈1.5k tokens in, 200 out), ~1 acknowledge, occasional translate&lt;br&gt;• At $5/$25 per million tokens: $0.01–0.02 per day, $0.30–0.60 per month&lt;br&gt;• Weekly read adds ~$0.05 per week&lt;br&gt;• Under 10% of a $9.99 subscription even with the strongest model; first thing to optimise at 10,000+ families" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="490" y="451" width="430" height="170" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Hard rules in every prompt&lt;/b&gt;&lt;br&gt;• No medical, legal, or financial advice&lt;br&gt;• Never pretend to be a family member&lt;br&gt;• Never mention monitoring, data, sensors, or that the family receives notes&lt;br&gt;• Reply in the member's language and address form; two sentences&lt;br&gt;• Escalate on the defined signals" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="940" y="451" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_8_Edge_cases_copy_accessibility" name="3.8 · Edge cases, copy, accessibility"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Edge cases we've decided, copy principles, accessibility" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Spec §14–16. Decided now so nobody re-decides them at 2 a.m." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Case" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="520" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Decision" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="800" height="24" as="geometry"/></mxCell><mxCell id="c5" value="DST change on arrival day" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="520" height="26" as="geometry"/></mxCell><mxCell id="c6" value="Arrival at the local wall-clock hour; if the hour doesn't exist, the next valid minute" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="134" width="800" height="26" as="geometry"/></mxCell><mxCell id="c7" value="Two organisers disagree (one marks away, one calls)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="520" height="26" as="geometry"/></mxCell><mxCell id="c8" value="Both actions logged; away wins for the ladder; both see each other's action" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="800" height="26" as="geometry"/></mxCell><mxCell id="c9" value="Member changes phone number" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="520" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Messenger link breaks; app shows “we lost Mom's Telegram”; re-invite flow" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="186" width="800" height="26" as="geometry"/></mxCell><mxCell id="c11" value="Family in two countries with different holidays" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="520" height="26" as="geometry"/></mxCell><mxCell id="c12" value="Holidays follow the kept-light member's country" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="212" width="800" height="26" as="geometry"/></mxCell><mxCell id="c13" value="Kept-light member answers before the arrival is sent" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="238" width="520" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Counts as today's answer; the arrival still goes out" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="238" width="800" height="26" as="geometry"/></mxCell><mxCell id="c15" value="One parent, two children set up separately" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="264" width="520" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Second setup detects the same channel identity and offers “join Anna's family”; MVP allows both; phase 2 merges" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="264" width="800" height="26" as="geometry"/></mxCell><mxCell id="c17" value="Organiser stops paying" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="520" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Light features stop after a 14-day grace; arrivals and the thread continue free; nobody is cut off from family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="800" height="26" as="geometry"/></mxCell><mxCell id="c19" value="A kept-light member dies" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="520" height="36" as="geometry"/></mxCell><mxCell id="c20" value="Any member marks it; all schedules stop within the hour; the archive is offered for export; no automated message of any kind afterwards; the family record is kept read-only for a year, then deleted unless exported" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="316" width="800" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Our own outage at the arrival minute" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="352" width="520" height="26" as="geometry"/></mxCell><mxCell id="c22" value="The next tick catches up; arrivals more than 3 h late say “sorry this is late”; the ladder never fires from our own outage" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="352" width="800" height="26" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Copy principles&lt;/b&gt;&lt;br&gt;• Address people by name. Never “the parent”, “the user”&lt;br&gt;• Neutral over alarming: “hasn't answered yet”, not “no response detected”&lt;br&gt;• Say what happens next: every notice ends with the one thing the reader can do&lt;br&gt;• The kept-light member is never described as monitored, checked on, or tracked, in any surface, including ours to the family&lt;br&gt;• English authored first; every string keyed; native review before a market launch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="640" height="170" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Accessibility (parent surface and messenger)&lt;/b&gt;&lt;br&gt;• Minimum 18 pt text; buttons at least 64 pt tall; contrast 7:1&lt;br&gt;• Voice everywhere: every text can be read aloud; every reply can be spoken&lt;br&gt;• No time-limited interactions; nothing disappears&lt;br&gt;• Android 8+ and iOS 15+ for the app; the messenger path works on anything that runs the messenger&lt;br&gt;• Kitchen-table mode: large clock, gentle chime, tap anywhere" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="398" width="640" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_1_Components" name="4.1 · Components"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Architecture: components" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="One deployable, one database per region, one queue. architecture/01-technical-design.md §1; drawing in architecture.drawio." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="FAMILY SIDE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="300" as="geometry"/></mxCell><mxCell id="c4" value="VELA PLATFORM · one Cloudflare Worker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="580" height="480" as="geometry"/></mxCell><mxCell id="c5" value="PARENT CHANNELS · adapters" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="320" height="480" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Vela app&lt;/b&gt;&lt;br&gt;React Native (Expo) · iOS, Android, web&lt;br&gt;parent surface and kitchen-table mode are display modes&lt;br&gt;push: one per member per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;setup · story archive · account · Stripe checkout" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="300" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;API + webhooks&lt;/b&gt;&lt;br&gt;Hono router · Supabase Auth JWT&lt;br&gt;answers light the flame synchronously" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;cron every 5 min → due query → queue&lt;br&gt;arrivals unique per member per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Outbound gateway&lt;/b&gt;&lt;br&gt;the only thing that sends to a person&lt;br&gt;budget by kind · idempotency · retries" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;AI service&lt;/b&gt;&lt;br&gt;Claude · structured outputs&lt;br&gt;prompt registry · every call logged" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Postgres (Neon) per region&lt;/b&gt;&lt;br&gt;eu · apac · us · Hyperdrive&lt;br&gt;answers 30 days rolling · events append-only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Media (R2) + event log&lt;/b&gt;&lt;br&gt;voice, photos, drawings; signed URLs (15 min)&lt;br&gt;events partitioned monthly; KPI job reads them" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Admin view + billing&lt;/b&gt;&lt;br&gt;who's quiet, what got flagged, what the model said&lt;br&gt;Stripe now; RevenueCat/IAP in phase 2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#