pp push" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="748" width="620" height="26" as="geometry"/></mxCell><mxCell id="c55" value="Modules with their own webhook routes; a new messenger is a new file" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="748" width="500" height="26" as="geometry"/></mxCell><mxCell id="c56" value="AI service" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="774" width="200" height="36" as="geometry"/></mxCell><mxCell id="c57" value="Transcription, understanding, flags, prompts, fallback, translation, weekly read, drift" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="774" width="620" height="36" as="geometry"/></mxCell><mxCell id="c58" value="Claude via the API; STT provider; prompt registry; every call logged with its input" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="774" width="500" height="36" as="geometry"/></mxCell><mxCell id="c59" value="Database" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="200" height="36" as="geometry"/></mxCell><mxCell id="c60" value="System of record" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="810" width="620" height="36" as="geometry"/></mxCell><mxCell id="c61" value="Postgres (Neon), one project per region, Hyperdrive from Workers; D1 stays in the prototype only" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="810" width="500" height="36" as="geometry"/></mxCell><mxCell id="c62" value="Media store · Event log" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="200" height="26" as="geometry"/></mxCell><mxCell id="c63" value="Voice notes, photos, drawings · append-only record of sends, answers, AI calls, decisions" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="846" width="620" height="26" as="geometry"/></mxCell><mxCell id="c64" value="R2 per region with signed URLs · Postgres table partitioned monthly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="846" width="500" height="26" as="geometry"/></mxCell><mxCell id="c65" value="Admin · Billing · Auth · Observability" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="872" width="200" height="36" as="geometry"/></mxCell><mxCell id="c66" value="Internal view; Free vs Light; member sign-in; errors and KPIs" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="872" width="620" height="36" as="geometry"/></mxCell><mxCell id="c67" value="Same Worker · Stripe then RevenueCat · Supabase Auth (magic link, phone OTP) · Sentry, Workers analytics, nightly KPI job" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="872" width="500" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_2_Data_flow_scheduler_gateway" name="4.2 · Data flow, scheduler, gateway"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="From a queued photo to a lit flame" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Every arrow writes an event. The KPI job reads events, never the live tables. Technical design §2–5." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Member queues an item&lt;/b&gt;&lt;br&gt;app → API: items.insert → event" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Cron, every 5 minutes&lt;/b&gt;&lt;br&gt;SELECT members WHERE next_arrival_at &lt;= now() AND no arrival for (member, local_day)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="300" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Composer&lt;/b&gt;&lt;br&gt;today's items → “whenever” items → story? → fallback? → render per channel" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="300" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · Outbound gateway&lt;/b&gt;&lt;br&gt;budget check → idempotency → adapter.send() → arrivals.sent_at → event" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="300" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Channel webhook: an answer&lt;/b&gt;&lt;br&gt;verify → parse → answers.insert → flame lights → cancel repeat/quiet → ack within 1 s" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1060" y="220" width="300" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · Queue: understand(answer_id)&lt;/b&gt;&lt;br&gt;transcribe → understand → translate → thread.post → notify contributor" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="220" width="300" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7 · Flag?&lt;/b&gt;&lt;br&gt;notice to the organiser with her words; calm reply to her" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;8 · Nightly KPI job&lt;/b&gt;&lt;br&gt;reads events → metrics_daily; prunes answers &gt;30 days; precision from quiet_events.outcome" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="300" height="70" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="200"/></Array></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Scheduler rules" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c19" value="Due when" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="220" height="24" as="geometry"/></mxCell><mxCell id="c20" value="Query" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="350" width="640" height="24" as="geometry"/></mxCell><mxCell id="c21" value="Idempotency" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="460" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Arrival" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="220" height="36" as="geometry"/></mxCell><mxCell id="c23" value="members.next_arrival_at &lt;= now() and no arrivals row for (member_id, local_day); next_arrival_at recomputed after each send from arrival_hour and IANA tz (DST-safe)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="374" width="640" height="36" as="geometry"/></mxCell><mxCell id="c24" value="UNIQUE(member_id, day) makes double sends impossible even if two crons overlap" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="374" width="460" height="36" as="geometry"/></mxCell><mxCell id="c25" value="Repeat" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="220" height="26" as="geometry"/></mxCell><mxCell id="c26" value="arrivals.sent_at &lt;= now() − 2.5 h, repeated_at is null, no answer, flame on, not away" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="410" width="640" height="26" as="geometry"/></mxCell><mxCell id="c27" value="repeated_at set once" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="460" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Quiet notice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="220" height="26" as="geometry"/></mxCell><mxCell id="c29" value="arrivals.sent_at &lt;= now() − T_quiet(member), no answer, flame on, not away, no open quiet_events row" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="436" width="640" height="26" as="geometry"/></mxCell><mxCell id="c30" value="one open quiet_events row per member per day" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="436" width="460" height="26" as="geometry"/></mxCell><mxCell id="c31" value="Turn prompt" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="220" height="26" as="geometry"/></mxCell><mxCell id="c32" value="members whose turn is tomorrow and local time is 19:00 ± 5 min" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="462" width="640" height="26" as="geometry"/></mxCell><mxCell id="c33" value="turns.prompt_sent_at" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="462" width="460" height="26" as="geometry"/></mxCell><mxCell id="c34" value="Weekly read" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="220" height="26" as="geometry"/></mxCell><mxCell id="c35" value="kept-light members, local Sunday 18:00 ± 5 min, no read for this week" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="488" width="640" height="26" as="geometry"/></mxCell><mxCell id="c36" value="weekly_reads(member_id, week_start) unique" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="488" width="460" height="26" as="geometry"/></mxCell><mxCell id="c37" value="Scale" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="220" height="26" as="geometry"/></mxCell><mxCell id="c38" value="100,000 members ≈ 14 due arrivals per tick on average, a few thousand at popular hours" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="514" width="640" height="26" as="geometry"/></mxCell><mxCell id="c39" value="One Postgres query and a queue absorb that" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="514" width="460" height="26" as="geometry"/></mxCell><mxCell id="c40" value="The outbound gateway (the notification budget in code)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c41" value="Step" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="220" height="24" as="geometry"/></mxCell><mxCell id="c42" value="Rule" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="590" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c43" value="1 · Budget" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="220" height="36" as="geometry"/></mxCell><mxCell id="c44" value="Check (member_id, local_day, kind) against limits: arrival 1, repeat 1 (kept-light only), turn_prompt 1, quiet_notice as they occur (organisers), weekly_read 1, ack 1, system as needed. Over budget → dropped and logged, never sent." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="614" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c45" value="2 · Idempotency" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="220" height="26" as="geometry"/></mxCell><mxCell id="c46" value="idempotencyKey unique in outbound; a duplicate is a no-op" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="650" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c47" value="3 · Send" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="220" height="36" as="geometry"/></mxCell><mxCell id="c48" value="adapter.send(); record sent_at and external id; on failure retry 3× with backoff over 30 min, then mark failed and open an admin alert; tell the organiser once (“we couldn't reach Mom on Telegram today”); the ladder does not fire from our own outage" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="676" width="1100" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_3_Data_model" name="4.3 · Data model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Data model (MVP)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Drawn in database.drawio. Green = the daily loop; amber = the paid Light layer; grey = supporting." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Table" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;sp