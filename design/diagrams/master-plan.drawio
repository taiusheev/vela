gn=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="386" width="300" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Founder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="386" width="160" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Solo non-technical founder; consumer AgeTech funding down 48% in 2026" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="340" height="36" as="geometry"/></mxCell><mxCell id="c40" value="AI co-founder builds; the prototype exists; revenue from day one; a human technical co-founder from the batch or network" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="422" width="520" height="36" as="geometry"/></mxCell><mxCell id="c41" value="No human technical co-founder by the end of phase 1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="422" width="300" height="36" as="geometry"/></mxCell><mxCell id="c42" value="Founder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="422" width="160" height="36" as="geometry"/></mxCell><mxCell id="c43" value="The AI says something wrong to a lonely parent" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="458" width="340" height="36" as="geometry"/></mxCell><mxCell id="c44" value="One acknowledgement a day, two sentences, scoped; hard rules; all conversations read by the founder in the pilot; eval set" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="458" width="520" height="36" as="geometry"/></mxCell><mxCell id="c45" value="Any flagged incident" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="458" width="300" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Both" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="458" width="160" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_6_Decisions_and_open_questions" name="7.6 · Decisions and open questions"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Decisions log and what is still open" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Append, never rewrite. Architecture decisions are on page 4.6." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Research before anything. Six reports across US, Europe, East Asia, sensing, AI apps, market size; a seventh on family-bridge apps." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="650" height="66" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Repo on GitHub, near-zero budget. Free tiers only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="650" height="66" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Don't deploy the bot before talking to customers. Built as a probe, parked until interviews say what the probe should be." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="650" height="66" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · No human welfare-check ladder, no partners. The family acts on silence; Vela informs and shows who is nearby." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="186" width="650" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · All families, not diaspora only. Diaspora remains the first wedge." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="650" height="66" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · ikigai Launchpad application submitted ($100k for 8% SAFE, Taipei, 12 weeks)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="262" width="650" height="66" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · One app for three generations. Free daily thread for everyone; paid Light for any kept-light member; the eldest joins by messenger and may graduate to a parent surface." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="338" width="650" height="66" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Pricing to test: free + Light at $9.99/mo or $79/yr per kept-light member." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="338" width="650" height="66" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Phase 0 before the app. Prove the loop with the prototype and 10–20 paying three-generation families." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="650" height="66" as="geometry"/></mxCell><mxCell id="c12" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · English first. All copy, wireframes, bot defaults, and documents authored in English; Russian and Chinese are localisations." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="414" width="650" height="66" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · The master plan page's checklist is the one task tracker. Asana CSV as optional export; Trello dropped. Draw.io for diagrams, Figma for wireframes, Gource for the repo history." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="650" height="66" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Architecture: Cloudflare Workers + Postgres per region + adapters; flame lights before AI; gateway enforces the budget; Stripe first, IAP in phase 2; Russia = legal review before launch." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="490" width="650" height="66" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Open for the founder's decision&lt;/b&gt;&lt;br&gt;• Company jurisdiction: Delaware if ikigai says yes, otherwise Estonia for cost; affects Stripe, store accounts, data residency&lt;br&gt;• Payments: confirm Stripe web checkout first, in-app purchases in phase 2&lt;br&gt;• Data residency: EU default, APAC for Taiwan; Russian localisation law reviewed by a lawyer before any Russian launch&lt;br&gt;• Brand: check vela.app and close domains; trademark conflicts in the first markets" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="640" height="170" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Open product questions&lt;/b&gt;&lt;br&gt;• Should the eldest know Vela exists, or does everything appear to come from family? Honesty says she knows; phase 0 tells us how it lands&lt;br&gt;• Is the existing family group the whole onboarding? A bot added to an existing Telegram family group needs no link; test with two families&lt;br&gt;• Grandchildren as the content engine: does Famileo's finding hold with a 20-year-old on Telegram?&lt;br&gt;• Free tier or trial only? Conversion at 90 days decides" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="576" width="640" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_7_Team_legal_brand" name="7.7 · Team, legal, brand"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Team and hiring, legal and compliance, brand" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The parts of the foundation that are not product or code." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Team and hiring" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Role" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="220" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Owns" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="500" height="24" as="geometry"/></mxCell><mxCell id="c6" value="When" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="600" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Founder (business, Taipei, RU + EN)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="220" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Customers: interviews, recruiting, onboarding, community, partners, fundraising; daily ops in the pilot; every decision on this page" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="164" width="500" height="36" as="geometry"/></mxCell><mxCell id="c9" value="Now, full-time" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="164" width="600" height="36" as="geometry"/></mxCell><mxCell id="c10" value="AI co-founder (Claude)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="220" height="36" as="geometry"/></mxCell><mxCell id="c11" value="Research, product spec, architecture, code, data, materials, this document; runs the loop and the metrics" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="500" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Now, always on" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="600" height="36" as="geometry"/></mxCell><mxCell id="c13" value="Human technical co-founder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="220" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Owns the codebase with the AI co-founder; on-call; the person investors ask for" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="236" width="500" height="26" as="geometry"/></mxCell><mxCell id="c15" value="Target: by the end of phase 1 (from the ikigai batch or network)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="236" width="600" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Customer-facing multilingual hire" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="220" height="26" as="geometry"/></mxCell><mxCell id="c17" value="Support, onboarding calls, community, native review of translations" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="262" width="500" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Phase 2 (first 1,000 families)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="262" width="600" height="26" as="geometry"/></mxCell><mxCell id="c19" value="Second engineer · growth lead" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="220" height="26" as="geometry"/></mxCell><mxCell id="c20" value="Adapters and the voice line · channel partnerships and the referral loop" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="288" width="500" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Phase 3, on revenue or seed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="288" width="600" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Advisors" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="220" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Ageing and eldercare; telecom or messaging platforms; the Russian-speaking diaspora; a lawyer for data law" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="314" width="500" height="36" as="geometry"/></mxCell><mxCell id="c24" value="Three conversations in phase 0 week 4, not fundraising" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="314" width="600" height="36" as="geometry"/></mxCell><mxCell id="c25" value="Legal and compliance matrix" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c26" value="Topic" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="220" height="24" as="geometry"/></mxCell><mxCell id="c27" value="Requirement" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="560" height="24" as="geometry"/></mxCell><mxCell id="c28" value="Our position" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="540" height="24" as="geometry"/></mxCell><mxCell id="c29" value="GDPR (EU default region)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="220" height="36" as="geometry"/></mxCell><mxCell id="c30" value="Lawful basis, minimisation, consent records, deletion, data residency, DPA with processors" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="424" width="560" height="36" as="geometry"/></mxCell><mxCell id="c31" value="Minimum data; consent events; deletion with hash; Neon and Cloudflare EU regions; DPAs signed before 1,000 EU families" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="424" width="540" height="36" as="geometry"/></mxCell><mxCell id="c32" value="Taiwan PDPA" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="220" height="26" as="geometry"/></mxCell><mxCell id="c33" value="Notice and consent; cross-border transfer rules" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="460" width="560" height="26" as="geometry"/></mxCell><mxCell id="c34" value="APAC region for Taiwanese families; Chinese-language notice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="460" width="540" height="26" as="geometry"/></mxCell><mxCell id="c35" value="Russia 152-FZ (localisation)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="220" height="36" as="geometry"/></mxCell><mxCell id="c36" value="Personal data of Russian citizens processed in Russia" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="486" width="560" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Pilot stores minimal data in the EU with consent; lawyer's review before any Russian launch (ADR-7)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="486" width="540" height="36" as="geometry"/></mxCell><mxCell id="c38" value="App store rules" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="220" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Digital subscriptions offered in-app must use in-app purchase; no health claims without substantiation" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="522" width="560" height="36" as="geometry"/></mxCell><mxCell id="c40" value="Stripe web first; IAP in phase 2; never claim fall detection or emergency response" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="522" width="540" height="36" as="geometry"/></mxCell><mxCell id="c41" value="Children" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="220" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Grandchildren under 13 contribute only through a parent's account" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="558" width="560" height="26" as="geometry"/></mxCell><mxCell id="c43" value="No child accounts; contributions attributed to the child but owned by the parent" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="558" width="540" height="26" as="geometry"/></mxCell><