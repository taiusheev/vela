<mxfile host="app.diagrams.net" modified="2026-09-12T07:04:03.637Z" agent="Vela generator" version="24.0.0"><diagram id="0_Overview_and_contents" name="0 · Overview and contents"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1078" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Vela · the foundation, as one map" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Every page of this file, by section. Open a tab at the bottom to go deeper. Source of truth: github.com/taiusheev/vela · updated 2026-09-12" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Vela&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;One family, three generations, and a light kept on.&lt;br&gt;One daily touch from the family; the family knows the moment it goes quiet.&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=3;fontColor=#1b2430;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="360" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 · Foundation&lt;/b&gt;&lt;br&gt;• 1.1 · Mission and promise&lt;br&gt;• 1.2 · The problem in numbers&lt;br&gt;• 1.3 · The worry, decomposed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="315" height="284" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;2 · Research&lt;/b&gt;&lt;br&gt;• 2.1 · How the world solves it today&lt;br&gt;• 2.2 · Findings by region&lt;br&gt;• 2.3 · Family-bridge benchmarks&lt;br&gt;• 2.4 · Ten truths and positioning" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="375" y="320" width="315" height="284" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;3 · Product&lt;/b&gt;&lt;br&gt;• 3.1 · The family and the two promises&lt;br&gt;• 3.2 · The daily loop&lt;br&gt;• 3.3 · States and consent&lt;br&gt;• 3.4 · Closer: the free layer&lt;br&gt;• 3.5 · Calmer: Vela Light&lt;br&gt;• 3.6 · Surfaces and channels&lt;br&gt;• 3.7 · The AI layer&lt;br&gt;• 3.8 · Edge cases, copy, accessibility" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="320" width="315" height="284" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;4 · Architecture&lt;/b&gt;&lt;br&gt;• 4.1 · Components&lt;br&gt;• 4.2 · Data flow, scheduler, gateway&lt;br&gt;• 4.3 · Data model&lt;br&gt;• 4.4 · Security, privacy, failure modes&lt;br&gt;• 4.5 · Delivery and cost at scale&lt;br&gt;• 4.6 · Architecture decisions" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1045" y="320" width="315" height="284" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;5 · Business&lt;/b&gt;&lt;br&gt;• 5.1 · Business model and pricing&lt;br&gt;• 5.2 · Revenue scenarios" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="315" height="284" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;6 · Go to market&lt;/b&gt;&lt;br&gt;• 6.1 · Markets and the growth loop&lt;br&gt;• 6.2 · Channel landscape" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="375" y="634" width="315" height="284" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;7 · Plan and operations&lt;/b&gt;&lt;br&gt;• 7.1 · Roadmap&lt;br&gt;• 7.2 · Phase 0 · four weeks&lt;br&gt;• 7.3 · Phases 1–3 in detail&lt;br&gt;• 7.4 · Metrics&lt;br&gt;• 7.5 · Risks&lt;br&gt;• 7.6 · Decisions and open questions&lt;br&gt;• 7.7 · Team, legal, brand&lt;br&gt;• 7.8 · Pitch deck and glossary" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="634" width="315" height="284" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c3" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;How to use this file&lt;/b&gt;&lt;br&gt;Read left to right, top to bottom: foundation → research → product → architecture → business → go to market → plan.&lt;br&gt;Green pages are the product and the plan; amber is the foundation. Tables are editable cells; every number is sourced in research/01–07 in the repo.&lt;br&gt;This file is generated from tools/build-master-plan-drawio.mjs; the founder may edit it directly in Draw.io, in which case tell the co-founder to stop regenerating." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="948" width="1320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1_1_Mission_and_promise" name="1.1 · Mission and promise"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Mission" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Why Vela exists, in the words we will keep using." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Vela keeps a light on for the people we love who live alone or far away: one daily touch from their family, and the family knows the moment it goes quiet.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1320" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;The world we are answering&lt;/b&gt;&lt;br&gt;Super-aged societies are here: Japan, Korea, Italy, Germany, Taiwan since 2025, China and the US next.&lt;br&gt;Around 50 million people over 65 live alone in the ten richest ageing countries; the number grows every year.&lt;br&gt;Behind each of them is a child, across town or across the world, who carries the same daily, unspoken worry: “she didn't pick up.”&lt;br&gt;And in the same families, a 20-year-old and a 45-year-old, both busy, both wanting more from each other than a group chat that went quiet." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="640" height="200" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;The promise, in two halves&lt;/b&gt;&lt;br&gt;&lt;b&gt;Closer.&lt;/b&gt; One moment a day from the people you love, then the app closes. Turns, prompts, grandchildren, translation, story day, memory. Free.&lt;br&gt;&lt;b&gt;Calmer.&lt;/b&gt; For whoever the family keeps a light on for: her answer lights a flame the family sees; silence gets a plan, not a spiral; the family knows within hours and knows who is nearby. Paid.&lt;br&gt;The name: &lt;i&gt;vela&lt;/i&gt; is a candle; &lt;i&gt;velar&lt;/i&gt; is to keep vigil. A light left on in the window. The family keeps it lit; the parent's answer is the glow." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="640" height="200" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;What Vela is not&lt;/b&gt;&lt;br&gt;• Not a device: nothing to install, wear, or charge for the eldest; she stays in the messenger she already uses.&lt;br&gt;• Not a monitor: nothing is detected; everything is expressed. She taps a heart or says “fine”. She sees what the family sees, and can say “stop”.&lt;br&gt;• Not an emergency service: the promise is “you'll know within hours, and you'll know who to call”, never “we'll save her”.&lt;br&gt;• Not a feed, not social media: no strangers, no ads, no infinite scroll, no notifications beyond the one moment. Screen time is a metric we want low.&lt;br&gt;• Not an ops company: no Vela staff on the ladder, no partners, no paid welfare checks. The family acts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="1320" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1_2_The_problem_in_numbers" name="1.2 · The problem in numbers"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1152" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The problem in numbers" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Sources: research/06 (market size and customer), research/03 (East Asia), research/01 (US). Every figure is cited in those reports." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="People living alone, by country" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Country" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="130" height="24" as="geometry"/></mxCell><mxCell id="c5" value="65+ living alone" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="140" width="330" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Detail" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="140" width="330" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Projection" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="140" width="330" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Source" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="200" height="24" as="geometry"/></mxCell><mxCell id="c9" value="United States" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="130" height="26" as="geometry"/></mxCell><mxCell id="c10" value="~15–16M · 26% of 65+ (2023); women 31%, men 19%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="164" width="330" height="26" as="geometry"/></mxCell><mxCell id="c11" value="65–84: 24% · 85+: 38% · women 75+: ~42%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="164" width="330" height="26" as="geometry"/></mxCell><mxCell id="c12" value="~10M “solo agers” 80+ by 2038 (Harvard JCHS)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="164" width="330" height="26" as="geometry"/></mxCell><mxCell id="c13" value="Pew 2025, ACL, KFF" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="164" width="200" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Japan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="130" height="36" as="geometry"/></mxCell><mxCell id="c15" value="7.37M (2020) · men 15%, women 22% of 65+" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="190" width="330" height="36" as="geometry"/></mxCell><mxCell id="c16" value="65+ single households 6.25M (2015) → 8.96M (2040); Tokyo 45.8% of elderly households solo by 2040" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="330" height="36" as="geometry"/></mxCell><mxCell id="c17" value="10.8M by 2050 (20.6% of all households)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="190" width="330" height="36" as="geometry"/></mxCell><mxCell id="c18" value="IPSS, Cabinet Office 2025" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="200" height="36" as="geometry"/></mxCell><mxCell id="c19" value="South Korea" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="130" height="36" as="geometry"/></mxCell><mxCell id="c20" value="70+ alone: 2.21M (2025) · 23.6% of seniors live alone (record)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="226" width="330" height="36" as="geometry"/></mxCell><mxCell id="c21" value="32.6% of senior solo households have no one to talk to; 34.8% no one to call when sick" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="226" width="330" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Single-person households 9.71M by 2037" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="226" width="330" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Korea Herald, Korea Times, MOHW" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="226" width="200" height="36" as="geometry"/></mxCell><mxCell id="c24" value="China" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="130" height="36" as="geometry"/></mxCell><mxCell id="c25" value="“Empty-nest” 59.7% of 60+ (2021), &gt;100M; ~25–30M truly alone" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop