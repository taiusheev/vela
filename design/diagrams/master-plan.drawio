<mxfile host="app.diagrams.net" modified="2026-09-12T06:21:07.165Z" agent="Vela generator" version="24.0.0"><diagram id="1_Overview_map" name="1 · Overview map"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Vela · master plan, at a glance" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Each box is a page in this file. Start here; double-click the tab names below to go deeper. Updated 2026-09-12." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Vela&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;One family, three generations, and a light kept on&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=3;fontColor=#1b2430;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="360" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Mission and problem&lt;/b&gt;&lt;br&gt;50M people 65+ live alone in the ten richest ageing countries&lt;br&gt;the worry is that silence is ambiguous&lt;br&gt;→ page 2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="280" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;What we learned&lt;/b&gt;&lt;br&gt;7 research reports, ~550 sources&lt;br&gt;8 approaches, 10 truths&lt;br&gt;→ page 3" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="280" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;The product&lt;/b&gt;&lt;br&gt;closer (free) + calmer (paid)&lt;br&gt;arrival · answer · flame · quiet notice&lt;br&gt;→ pages 4–7" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="140" width="280" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Architecture&lt;/b&gt;&lt;br&gt;one Worker, Postgres per region, adapters&lt;br&gt;flame lights before any AI&lt;br&gt;→ page 8" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="280" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Business model&lt;/b&gt;&lt;br&gt;free layer spreads; Light $9.99/mo pays&lt;br&gt;AI ≈ $0.30–0.60 per kept-light member/month&lt;br&gt;→ page 9" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="280" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Go to market&lt;/b&gt;&lt;br&gt;Russian-speaking families → Taiwan → PH/IN/UA/LatAm → DE/UK/JP&lt;br&gt;growth through contributors&lt;br&gt;→ page 10" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="620" width="280" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Roadmap and phase 0&lt;/b&gt;&lt;br&gt;prove the loop → MVP → the bridge → the read&lt;br&gt;4-week checklist with owners&lt;br&gt;→ pages 11–12" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="620" width="280" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Metrics, risks, decisions&lt;/b&gt;&lt;br&gt;10 metrics with 90-day targets&lt;br&gt;9 risks with mitigations · 12 decisions&lt;br&gt;→ pages 13–15" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="280" height="110" as="geometry"/></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c3" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="2_Mission_and_problem" name="2 · Mission and problem"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Mission and the problem" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Why this company exists, and the numbers that justify it. Sources are in research/06 and research/03." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Vela keeps a light on for the people we love who live alone or far away:&lt;/b&gt; one daily touch from their family, and the family knows the moment it goes quiet." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1320" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;45–50M&lt;/b&gt;&lt;br&gt;people 65+ living alone in the ten richest ageing markets (+25–30M in China)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="315" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;8.96M&lt;/b&gt;&lt;br&gt;Japanese 65+ solo households by 2040 (6.7M in 2020)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="200" width="315" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;23.6%&lt;/b&gt;&lt;br&gt;of Korean seniors live alone (2025, record)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="200" width="315" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2025&lt;/b&gt;&lt;br&gt;the year Taiwan became super-aged" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="200" width="315" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;76,020 · 21,856&lt;/b&gt;&lt;br&gt;died alone at home in Japan in 2024 · found after 8+ days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="315" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;1 in 5&lt;/b&gt;&lt;br&gt;falls become a long lie of over an hour" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="296" width="315" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;12% vs 67%&lt;/b&gt;&lt;br&gt;mortality if found within 1 h vs helpless over 72 h" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="296" width="315" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;3 in 4&lt;/b&gt;&lt;br&gt;falls among pendant wearers happen with the pendant off" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="296" width="315" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;~2%&lt;/b&gt;&lt;br&gt;of French alarm-centre calls are true emergencies; 98% are reassurance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="315" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;63M · 1 in 3&lt;/b&gt;&lt;br&gt;US family caregivers in 2025 · long-distance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="392" width="315" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;~300M&lt;/b&gt;&lt;br&gt;people living outside their birth country" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="392" width="315" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;$10–35&lt;/b&gt;&lt;br&gt;monthly willingness to pay for this feeling, in every market studied" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="392" width="315" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;The insight that organises everything&lt;/b&gt;&lt;br&gt;The worry happens because &lt;b&gt;silence is ambiguous&lt;/b&gt;.&lt;br&gt;Every product that ever delivered peace of mind did one thing: it made silence mean “nothing is wrong, because if it were, you'd know.”&lt;br&gt;Sensors, AI, pendants are just different ways of earning the right to say that." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="640" height="150" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;The five layers of the worry&lt;/b&gt;&lt;br&gt;&lt;b&gt;The spike&lt;/b&gt;: “she didn't pick up.” Frequent, unlearned-from.&lt;br&gt;&lt;b&gt;The catastrophe&lt;/b&gt;: a fall nobody discovers.&lt;br&gt;&lt;b&gt;The slow slide&lt;/b&gt;: is she eating, is she sadder, is she forgetting.&lt;br&gt;&lt;b&gt;The helplessness&lt;/b&gt;: what could I do from 8,000 km?&lt;br&gt;&lt;b&gt;The guilt&lt;/b&gt;: I should call more." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="640" height="150" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;And the parent's side, which decides whether anything survives contact with reality&lt;/b&gt;&lt;br&gt;“I am not a patient. A pendant says I am.” · “Don't watch me.” (cameras 37% acceptance, sensors 59%, wearables 81%) · “I don't want to be a burden, but I am lonely.” · “Unknown numbers are spam.”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1320" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_What_we_learned" name="3 · What we learned"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="How the world solves it today, and the ten truths" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Condensed from research/00-SYNTHESIS.md and research/07-family-bridge-apps.md." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Emergency pendants&lt;/b&gt;&lt;br&gt;Life Alert, Medical Guardian, Tunstall, Careium · 16M users EU+NA&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; 24/7 human response; reimbursement codes (DE €25.50)&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; stigma; 18% all-day wear; 9% adoption for a decade" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Consumer wearables&lt;/b&gt;&lt;br&gt;Apple Watch, Pixel, Galaxy&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; no stigma, no fee, fall detection&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; 18-h battery; 911-first; no remote setup; useless with dementia" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Home sensors&lt;/b&gt;&lt;br&gt;Aloe, Envoy, Vayyar, Nobi, Sensi&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; solves non-wear; funded for facilities&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; ten dead consumer brands; $40–100/mo + hardware; privacy" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Utility signals&lt;/b&gt;&lt;br&gt;Zojirushi kettle, Yamato bulb, Kansai meter, Shanghai water&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; zero install, accepted, near-free&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; one low-fidelity signal; no family layer; 14k subs in 23 yrs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;AI check-in calls&lt;/b&gt;&lt;br&gt;Naver CareCall (50k), ElliQ, inTouch, AloneAssist&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; cheapest thing that scaled; multilingual&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; all government-paid; parents screen unknown numbers; “mechanical care”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="276" width="315" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Check-in apps&lt;/b&gt;&lt;br&gt;Snug ($19.99 alert tier), Iamfine, Enrich (LINE)&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; elders self-enrol; the paid tier sells the alert&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; bare pings attract the young, not the old; tiny" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="276" width="315" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Family-presence products&lt;/b&gt;&lt;br&gt;Famileo (260k paying families), GrandPad, Aura, Chikaku, Storyworth&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; parents love them; half of Aura's sales from family invites&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; print or hardware; no idea if grandma opened it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="276" width="315" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Family social networks&lt;/b&gt;&lt;br&gt;Path, Cocoon, 23snaps (dead); Marco Polo, Locket, BeReal&lt;br&gt;&lt;b&gt;Works:&lt;/b&gt; small circles; one daily prompt (BeReal 68% open in 3 min)&lt;br&gt;&lt;b&gt;Fails:&lt;/b&gt; die against the group chat; messaging converts ~1%" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="276" width="315" height="150" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Ten truths that hold in every country&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1320" height="40" as="geometry"/></mxCell><mxCell id="c12" value="01 The buyer is not the user. The child pays; the parent tolerates." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="650" height="46" as="geometry"/></mxCell><mxCell id="c13" value="02 Two jobs, not one: emergency (2%) and daily reassurance (98%). Amazon bundled them at $20 and cancelled." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="500" width="650" height="46" as="geometry"/></mxCell><mxCell id="c14" value="03 Zero-install wins; hardware-first dies." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="650" height="46" as="geometry"/></mxCell><mxCell id="c15" value="04 Silence needs a plan, not a notification." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="556" width="650" height="46" as="geometry"/></mxCell><mxCell id="c16" value="05 Precision is unsolved: 0.3% true positives in Seoul; nobody publishes numbers. We will." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="650" height="46" as="geometry"/></mxCell><mxCell id="c17" value="06 Willingness to pay is $10–35/month, everywhere." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="612" width="650" height="46" as="geometry"/></mxCell><mxCell id="c18" value="07 LTV is capped at 2–4 years by the eldest's trajectory." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="650" height="46" as="geometry"/></mxCell><mxCell id="c19" value="08 The 70–80 “pre-dependency” segment is unserved and insulted by everything on offer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="668" width="650" height="46" as="geometry"/></mxCell><mxCell id="c20" value="09 Distribution is the moat: utilities, telcos, post, councils, remittance apps." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="724" width="650" height="46" as="geometry"/></mxCell><mxCell id="c21" value="10 Content from family gets opened with joy; pings get ignored." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="724" width="650" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_Product_the_family" name="4 · Product · the family"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The product: one family, three generations, two promises" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The unit is the family, not a pair. Anyone the family worries about can carry a flame; it is opt-in and visible to them." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;The family's daily thread&lt;/b&gt;&lt;br&gt;one moment a day · no feed · no strangers · no ads · free&lt;br&gt;turns · prompts · grandchildren · translation · story day · memory" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="460" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Grandmother · 78 · lives alone&lt;/b&gt;&lt;br&gt;joins through her messenger, installs nothing&lt;br&gt;&lt;b&gt;flame on&lt;/b&gt;: her answer is the sign of life&lt;br&gt;story day makes her the author, not the patient" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Parent · 45 · organiser · pays&lt;/b&gt;&lt;br&gt;both a child (of the 78-year-old) and a parent (of the 20-year-old)&lt;br&gt;sets up the family, names the nearby contacts&lt;br&gt;gets the flame, the weekly read, the quiet notice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="560" width="300" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Student · 20 · abroad&lt;/b&gt;&lt;br&gt;best contributor: a 10-second voice note gets the strongest reply&lt;br&gt;best recruiter: invites the family&lt;br&gt;&lt;b&gt;own flame, opt-in&lt;/b&gt;, on his terms, while abroad" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="300" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Nearby contact · neighbour, cousin&lt;/b&gt;&lt;br&gt;consents once&lt;br&gt;called only when the light stays dark&lt;br&gt;never receives anything else" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="300" height="110" as="geometry"/></mxCell><mxCell id="c8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;Closer · free · for everyone&lt;/b&gt;&lt;br&gt;• One moment a day, then the app closes&lt;br&gt;• Turns: each member gets a day; a prompt arrives the evening before&lt;br&gt;• Prompts that know the family, drawn from what people actually said&lt;br&gt;• Grandchildren first-class: voice, drawing, photo without writing&lt;br&gt;• Translation both ways, keeping her form of address&lt;br&gt;• Story day: one question a week; her answers become a book&lt;br&gt;• Memory: the Thursday appointment, the exam, the neighbour's name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="640" height="140" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Calmer · Vela Light · paid&lt;/b&gt;&lt;br&gt;• The flame: her daily answer lights it on the family's home screen&lt;br&gt;• Quiet notice to the organiser after her usual window (never before +4 h), nearby contacts one tap away&lt;br&gt;• Away mode: “going to my sister's until Sunday” pauses everything&lt;br&gt;• Weekly read: how she really is, in neutral words, from her own replies&lt;br&gt;• Memory and reminders, story archive export, later drift with published precision&lt;br&gt;• Nothing to install, wear, or charge. The family acts; Vela never knocks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="640" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5_Product_daily_loop" name="5 · Product · daily loop"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The daily loop and the quiet ladder" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="From product/03-product-spec.md §3–5. Silence only matters for members with a flame." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="THE FAMILY (any member, any time)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c4" value="VELA (scheduler + AI)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c5" value="THE KEPT-LIGHT MEMBER" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c6" value="THE ORGANISER (when the light stays dark)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Queue something&lt;/b&gt;&lt;br&gt;voice · photo · drawing · question&lt;br&gt;for today or “whenever”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Evening before: turn prompt&lt;/b&gt;&lt;br&gt;“Tomorrow is Sam's day. She mentioned the tomatoes; ask for a photo.”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="300" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Thread updates&lt;/b&gt;&lt;br&gt;her answer, transcribed and translated;&lt;br&gt;whoever's content she answered is told" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="280" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Compose the arrival (her hour)&lt;/b&gt;&lt;br&gt;1 queued for today · 2 queued “whenever” (max 2)&lt;br&gt;3 story question (story day) · 4 Vela fallback, signed as Vela&lt;br&gt;one photo visible · voice as voice · her language and address form" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="360" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Read the answer (after the flame lit)&lt;/b&gt;&lt;br&gt;transcribe · one neutral line · mood words · mentions&lt;br&gt;flag: none | escalate → organiser with her words&lt;br&gt;away detected? confirm back" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="340" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Flame lights&lt;/b&gt;&lt;br&gt;on the raw answer, before any AI&lt;br&gt;repeat and quiet cancelled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="280" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;+2.5 h, no answer:&lt;/b&gt; repeat once" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="220" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;One message&lt;/b&gt;&lt;br&gt;“Good morning, Mrs Ivanova…” + Mia's photo&lt;br&gt;[ ☀️ I'm fine ]  🎤   (or: reply with anything, even a heart)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="360" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;One easy answer&lt;/b&gt;&lt;br&gt;tap · heart · voice · text · photo · anything counts&lt;br&gt;“stop” turns the flame off; the organiser is told" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="340" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Quiet notice · arrival + T_quiet&lt;/b&gt;&lt;br&gt;T_quiet = median latency (14 d) + 2 h, floor 4 h, cap 8 h&lt;br&gt;last contact · usual time · yesterday's words&lt;br&gt;[Call] [Ask to check] [She's away] [Wait 2 h]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="650" width="340" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;The family acts&lt;/b&gt;&lt;br&gt;a call, a neighbour's knock&lt;br&gt;Vela never knocks&lt;br&gt;auto-ask a contact only if opted in" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="280" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Precision accounting&lt;/b&gt;&lt;br&gt;every notice records an outcome:&lt;br&gt;answered late · away · true concern · unknown&lt;br&gt;precision = true concern ÷ notices, published monthly" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="360" height="90" as="geometry"/></mxCell><mxCell id="c19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e0a23a;strokeWidth=2;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="6_Product_surfaces_and_channels" name="6 · Product · surfaces and channels"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Surfaces and channels" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The eldest never learns anything new. No family is told “your grandmother's messenger isn't supported”; no adapter, no launch in that market." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;The app (iOS, Android, web)&lt;/b&gt;&lt;br&gt;for every member who can install&lt;br&gt;home: flames and today's moment · thread · queue · turns and prompts · story archive · own flame settings&lt;br&gt;&lt;b&gt;must not:&lt;/b&gt; a feed, badge counts, anything that rewards frequent opening" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="425" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Parent surface (same app, simplified mode)&lt;/b&gt;&lt;br&gt;for the eldest, when a child installs it on a visit&lt;br&gt;one screen: the arrival · big “I'm fine” · voice reply · call the organiser · “what the family sees” · “stop”&lt;br&gt;18 pt text, 64 pt buttons, 7:1 contrast, everything read aloud" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="110" width="425" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Kitchen-table mode&lt;/b&gt;&lt;br&gt;an old phone or tablet on her table&lt;br&gt;cycles family photos when idle; wakes to the arrival; tap anywhere to answer; large clock&lt;br&gt;no notifications beyond a gentle chime at her hour" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="110" width="425" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Messenger (Telegram, MAX, WhatsApp, LINE, Viber)&lt;/b&gt;&lt;br&gt;for the eldest who won't install; for casual members&lt;br&gt;arrival as one message; button where supported; any reply counts&lt;br&gt;commands in her language: stop · start · what does the family see" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="425" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Voice line and SMS (later)&lt;/b&gt;&lt;br&gt;for a parent with a landline&lt;br&gt;a call at her hour from a saved number plays the family's voice notes; “press 1 if you're fine, or just say something”&lt;br&gt;last in the roadmap, first in importance for 80+" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="278" width="425" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Nearby contact&lt;/b&gt;&lt;br&gt;installs nothing&lt;br&gt;one message, only when the light stays dark and the organiser asks&lt;br&gt;consents once" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="278" width="425" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Channel adapters&lt;/b&gt; · one contract: send(link, message) · parseWebhook(req) · capabilities{buttons, voiceOut, voiceIn, readReceipts, media}" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="600" height="30" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;Russia daily leader, CIS, Ukraine&lt;br&gt;free bot API, buttons, voice&lt;br&gt;throttled in Russia, may be blocked" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="315" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;MAX&lt;/b&gt;&lt;br&gt;Russia monthly-reach leader since mid-2026&lt;br&gt;official bot API&lt;br&gt;state-run: assume everything is readable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="505" width="315" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;WhatsApp Business API&lt;/b&gt;&lt;br&gt;Philippines, India, LatAm, Europe, US&lt;br&gt;template messages outside 24 h; small per-message cost&lt;br&gt;blocked in Russia since Feb 2026" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="505" width="315" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;LINE&lt;/b&gt;&lt;br&gt;Taiwan, Japan, Thailand&lt;br&gt;rich messages&lt;br&gt;the Taiwan launch channel" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="505" width="315" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Viber&lt;/b&gt;&lt;br&gt;Ukraine, parts of CIS&lt;br&gt;bot API" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="609" width="315" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Voice / SMS&lt;/b&gt;&lt;br&gt;landline parents&lt;br&gt;Twilio-class provider&lt;br&gt;TTS + DTMF or speech" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="609" width="315" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;In-app&lt;/b&gt;&lt;br&gt;members and parents who installed the app&lt;br&gt;push: exactly one per member per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="609" width="315" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_Product_AI_layer" name="7 · Product · AI layer"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The AI layer, and the line it never crosses" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Every call uses a versioned prompt and a JSON schema; every output is logged with its input. Strongest model for understanding; cheaper paths for transcription." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;understand&lt;/b&gt;&lt;br&gt;in: answer text/transcript, last 3 summaries, profile&lt;br&gt;out: summary · mood words · mentions · flag + reason · away{until}&lt;br&gt;guardrail: never quote her to the family; never infer diagnoses" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;flag what matters now&lt;/b&gt;&lt;br&gt;pain, fall, dizziness, chest or breathing, not eating, hopelessness, a stranger, a “bank” call, money&lt;br&gt;to the organiser with her words; calm warm reply to her&lt;br&gt;never medical advice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;acknowledge&lt;/b&gt;&lt;br&gt;one warm reply to a kept-light member, once a day&lt;br&gt;≤ 2 sentences, ≤ 1 question, her language and address form&lt;br&gt;never continues into a conversation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;prompt the family&lt;/b&gt;&lt;br&gt;evening-before suggestion from recent mentions and family dates&lt;br&gt;one sentence, one concrete ask&lt;br&gt;suggestions only; nothing auto-sent as a person" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;fallback morning&lt;/b&gt;&lt;br&gt;two lines when nobody sent anything&lt;br&gt;references yesterday and her weather&lt;br&gt;always signed “Vela, from your family”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;translate&lt;/b&gt;&lt;br&gt;both directions, register-preserving&lt;br&gt;the model is told who is speaking to whom&lt;br&gt;original shown alongside" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;weekly read&lt;/b&gt;&lt;br&gt;3–5 lines from 7 days of summaries and timing&lt;br&gt;“later than usual”, never “concerning”&lt;br&gt;one suggestion at most" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="425" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;drift (phase 3)&lt;/b&gt;&lt;br&gt;per-person baseline: latency, length, sentiment, vocabulary, topics&lt;br&gt;sustained change over 2–3 weeks&lt;br&gt;framed as “worth a call”; precision published" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="382" width="425" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;transcribe&lt;/b&gt;&lt;br&gt;speech-to-text provider, Claude for cleanup&lt;br&gt;member's language, auto-detect fallback&lt;br&gt;cached by media id" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="382" width="425" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Evaluation and cost&lt;/b&gt;&lt;br&gt;Held-out set of real answers (consented, anonymised), hand-labelled for summary quality, flag correctness, away detection; runs on every prompt change; flag recall must not drop.&lt;br&gt;Quiet-notice precision comes from quiet_events.outcome, not from the model.&lt;br&gt;Cost per kept-light member: about $0.01–0.02 per day, $0.30–0.60 per month; under 10% of a $9.99 subscription." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="640" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Hard rules in every prompt&lt;/b&gt;&lt;br&gt;• No medical, legal, or financial advice&lt;br&gt;• Never pretend to be a family member; if asked, “a helper Anna asked to say good morning”&lt;br&gt;• Never mention monitoring, data, sensors, or that the family receives notes&lt;br&gt;• Reply in the member's language and address form; two sentences&lt;br&gt;• Escalate on the defined signals; a human decides what reaches the family" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="540" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="8_Architecture" name="8 · Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Architecture" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="One deployable, one database per region, one queue. Detail in architecture/01-technical-design.md; decisions in architecture/decisions.md; drawings in architecture.drawio and database.drawio." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="FAMILY SIDE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="300" as="geometry"/></mxCell><mxCell id="c4" value="VELA PLATFORM · one Cloudflare Worker" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="110" width="580" height="480" as="geometry"/></mxCell><mxCell id="c5" value="PARENT CHANNELS · adapters" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="320" height="480" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Vela app&lt;/b&gt;&lt;br&gt;React Native (Expo) · iOS, Android, web&lt;br&gt;parent surface and kitchen-table mode are display modes&lt;br&gt;push: one per member per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;setup · story archive · account · Stripe checkout" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="300" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;API + webhooks&lt;/b&gt;&lt;br&gt;Hono router · Supabase Auth JWT&lt;br&gt;answers light the flame synchronously" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;cron every 5 min → due query → queue&lt;br&gt;arrivals unique per member per day" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Outbound gateway&lt;/b&gt;&lt;br&gt;the only thing that sends to a person&lt;br&gt;budget by kind · idempotency · retries" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;AI service&lt;/b&gt;&lt;br&gt;Claude · structured outputs&lt;br&gt;prompt registry · every call logged" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Postgres (Neon) per region&lt;/b&gt;&lt;br&gt;eu · apac · us&lt;br&gt;answers 30 days rolling · events append-only" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Media (R2) + event log&lt;/b&gt;&lt;br&gt;voice, photos, drawings; signed URLs&lt;br&gt;events partitioned monthly; KPI job reads them" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="260" height="90" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Admin view + billing&lt;/b&gt;&lt;br&gt;who's quiet, what got flagged, what the model said&lt;br&gt;Stripe now; RevenueCat/IAP in phase 2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="470" width="260" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Channel interface&lt;/b&gt;&lt;br&gt;send(link, msg) · parseWebhook(req)&lt;br&gt;capabilities per channel" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="470" width="260" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Telegram (prototype = first adapter)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="280" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;MAX&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="280" height="46" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;WhatsApp Business API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="260" width="280" height="46" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;LINE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="320" width="280" height="46" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Viber&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="280" height="46" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Voice / SMS (later)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="440" width="280" height="46" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;In-app push&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="280" height="46" as="geometry"/></mxCell><mxCell id="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c10" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c15" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Principles that shape the code&lt;/b&gt;&lt;br&gt;• The flame lights on the raw answer, before any AI runs (nothing on the safety path depends on a model)&lt;br&gt;• One outbound gateway enforces the notification budget: the anti-addiction promise is code&lt;br&gt;• Arrivals are UNIQUE(member_id, day): double sends are impossible even if two crons overlap&lt;br&gt;• Adapters are pure translation layers; a new messenger is a new file&lt;br&gt;• Every AI output is logged with its prompt version; an eval set runs on every prompt change" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="640" height="160" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Failure modes, decided&lt;/b&gt;&lt;br&gt;• Messenger down: retry 30 min, tell the organiser once; the ladder does not fire from our own outage&lt;br&gt;• Worker down at the arrival minute: next tick catches up; late arrivals say “sorry this is late”&lt;br&gt;• AI down: the flame still lights; understanding runs when the queue drains&lt;br&gt;• Wrong time zone: confirmed by the first three answer times; 3-h mismatch triggers a check&lt;br&gt;• A kept-light member dies: schedules stop within the hour; no automated message ever again" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="620" width="640" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="9_Business_model" name="9 · Business model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Business model" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The free layer spreads; the light pays. Priced at the bottom of the $10–35 band because the payer is often young and the eldest's life is finite." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Vela · free · for everyone&lt;/b&gt;&lt;br&gt;• The daily moment, thread, turns, prompts, contributors, translation, story day&lt;br&gt;• Why free: contributors are the growth engine; ~8 relatives per paying family at Famileo; half of Aura's sales come from family invites&lt;br&gt;• Risk: becoming a free messenger with 1% conversion → the free layer is one moment a day, not chat" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="640" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Vela Light · $9.99/month or $79/year per kept-light member · +50% for a second&lt;/b&gt;&lt;br&gt;• The flame, quiet notices, nearby contacts, away mode, weekly read, memory, archive export, drift&lt;br&gt;• Why paid: people pay for the meaning of silence; Snug's $19.99 tier sells exactly this&lt;br&gt;• Trial: 30 days of Light after the first answer, so a family sees one weekly read or one quiet notice before paying&lt;br&gt;• To test in 90 days: $9.99 vs $14.99 vs annual-only; move the line if conversion &amp;lt; 25%" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="640" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Comparables&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="400" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Famileo&lt;/b&gt;&lt;br&gt;£5.99–17.99/mo&lt;br&gt;260k families, €14M revenue 2024" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="248" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Snug Dispatch&lt;/b&gt;&lt;br&gt;$19.99/mo&lt;br&gt;the alert is what sells" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="308" y="350" width="248" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Docomo Chikaku&lt;/b&gt;&lt;br&gt;¥1,980/mo&lt;br&gt;sold in every Docomo shop; Aflac invested" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="576" y="350" width="248" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ViewClix&lt;/b&gt;&lt;br&gt;$9.95/mo per family&lt;br&gt;one fee for the whole family" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="350" width="248" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Germany Hausnotruf&lt;/b&gt;&lt;br&gt;€25.50/mo reimbursed&lt;br&gt;public price anchor for this outcome" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1112" y="350" width="248" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Unit economics&lt;/b&gt;&lt;br&gt;• No hardware, no staff on the ladder; AI ≈ $0.30–0.60 per kept-light member per month&lt;br&gt;• Infrastructure under 2% of revenue at every scale (page 8)&lt;br&gt;• LTV capped at 2–4 years per kept-light member → acquisition must stay under $60 per family&lt;br&gt;• Plan: word of mouth inside families and communities; the under-30 member recruits&lt;br&gt;• Payments: Stripe web checkout first; in-app purchases in phase 2 (store rules)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="640" height="170" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Scale table (monthly, order of magnitude)&lt;/b&gt;&lt;br&gt;100 families: infra $0 · AI ~$40 · total &amp;lt; $50 · revenue ~$400&lt;br&gt;1,000: infra ~$30 · AI ~$400 · total ~$500 · revenue ~$4,000&lt;br&gt;10,000: infra ~$170 · AI ~$4,000 · total ~$5,000 · revenue ~$40,000&lt;br&gt;100,000: infra ~$1,700 · AI ~$40,000 · total ~$47,000 · revenue ~$400,000&lt;br&gt;(revenue assumes 40% of families on Light at $9.99)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="450" width="640" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="10_Go_to_market" name="10 · Go to market"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Go to market" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Where we start and why; how a family spreads. Channel caution: WhatsApp blocked in Russia since Feb 2026, Telegram throttled, MAX leads reach." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Wave 1 · Russian-speaking families&lt;/b&gt;&lt;br&gt;sharpest pain among the ~600k who emigrated since 2022 and whose parents stayed&lt;br&gt;the founder is one of them and can reach them; hard-currency payers; no product exists&lt;br&gt;channel: Telegram communities, personal network; parents via Telegram and MAX" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Wave 2 · Taiwan&lt;/b&gt;&lt;br&gt;super-aged since 2025; the founder lives there&lt;br&gt;LINE is one adapter away&lt;br&gt;channel: LINE; Taiwanese friends; university networks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="375" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Wave 3 · Philippines, India, Ukraine, Latin America&lt;/b&gt;&lt;br&gt;2.2M overseas Filipino workers; 18.5M Indians abroad&lt;br&gt;same family shape at scale; remittance apps already bill this customer monthly&lt;br&gt;channel: WhatsApp; Remitly (9M), Wise (15M), Paysend (10M) partnerships" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Wave 4 · Germany, UK, Japan&lt;/b&gt;&lt;br&gt;insurers and councils reimburse ~€25/mo for this outcome&lt;br&gt;no software-only entrant exists in those tenders&lt;br&gt;channel: reimbursement codes, with our published precision" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="110" width="315" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;A 20-year-old installs Vela&lt;/b&gt;&lt;br&gt;for his grandmother" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Invites his mother and aunt&lt;/b&gt;&lt;br&gt;contributors, free" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;The mother switches on the light&lt;/b&gt;&lt;br&gt;and pays" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;The aunt tells her own family&lt;/b&gt;&lt;br&gt;a new organiser" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="460"/><mxPoint x="180" y="460"/></Array></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;The growth loop&lt;/b&gt; · every family is five to eight people; every member is a potential organiser of another family" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1320" height="30" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Later channels&lt;/b&gt;&lt;br&gt;• Telcos and remittance apps that already bill this exact customer monthly (precedent: AXA × Western Union insurance inside transfers; Aflac invested in Chikaku)&lt;br&gt;• Employers of relocants (IT firms in Yerevan, Tbilisi, Almaty)&lt;br&gt;• Insurers in Germany, the UK, Japan once precision is published" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="640" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;What we don't do&lt;/b&gt;&lt;br&gt;• Paid ads before the referral loop works&lt;br&gt;• A single messenger in any market&lt;br&gt;• Care homes as a channel in CIS (no Famileo-style network exists there)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="640" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="11_Roadmap" name="11 · Roadmap"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Roadmap: twelve months, four phases, each with an exit test" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Dates assume phase 0 starts 14 September 2026. Each phase ends with a decision, not a date." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Sep" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Oct" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Nov" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="380" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Dec" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Jan" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Feb" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="650" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Mar" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Apr" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c11" value="May" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c12" value="Jun" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="1010" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c13" value="Jul" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="1100" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Aug" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7d8794;" vertex="1" parent="1"><mxGeometry x="1190" y="120" width="90" height="24" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Phase 0 · prove the loop&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="150" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Survey + 20 interviews (wk 1–2)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="90" height="40" as="geometry"/></mxCell><mxCell id="c17" value="Pilot 10–20 families, no app (wk 3–4)" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="206" width="90" height="30" as="geometry"/></mxCell><mxCell id="c18" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="278" y="168" width="24" height="24" as="geometry"/></mxCell><mxCell id="c19" value="Decision 12 Oct" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="166" width="220" height="30" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Phase 1 · MVP&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="150" height="40" as="geometry"/></mxCell><mxCell id="c21" value="App + Telegram/WhatsApp/LINE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="180" height="40" as="geometry"/></mxCell><mxCell id="c22" value="100 families; pricing test; Stripe" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="290" y="316" width="180" height="30" as="geometry"/></mxCell><mxCell id="c23" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="458" y="278" width="24" height="24" as="geometry"/></mxCell><mxCell id="c24" value="Exit: conversion &gt; 25%, D30 &gt; 85%" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="486" y="276" width="220" height="30" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Phase 2 · the bridge&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="150" height="40" as="geometry"/></mxCell><mxCell id="c26" value="Parent surface, kitchen-table mode, grandchildren tools, translation, story day, memory, MAX, Viber" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="380" width="270" height="40" as="geometry"/></mxCell><mxCell id="c27" value="Taiwan on LINE · 1,000 families" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="426" width="270" height="30" as="geometry"/></mxCell><mxCell id="c28" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="728" y="388" width="24" height="24" as="geometry"/></mxCell><mxCell id="c29" value="Exit: contributors ≥ 3, family-content &gt; 60%" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="756" y="386" width="220" height="30" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Phase 3 · the read&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="150" height="40" as="geometry"/></mxCell><mxCell id="c31" value="Drift with published precision, voice line, second-member plans" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="490" width="540" height="40" as="geometry"/></mxCell><mxCell id="c32" value="First channel partner · 10,000 families · seed on evidence" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="740" y="536" width="540" height="30" as="geometry"/></mxCell><mxCell id="c33" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1268" y="498" width="24" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Exit: read trusted and paid" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1296" y="496" width="220" height="30" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Exit tests&lt;/b&gt;&lt;br&gt;• Phase 0: answer rate &gt; 85%; family-content days &gt; 30% by week two; ≥ 4 families paying; parents not refusing&lt;br&gt;• Phase 1: Light conversion &gt; 25%; D30 &gt; 85%; answer rate &gt; 85%; members per family ≥ 5&lt;br&gt;• Phase 2: contributors ≥ 3; family-content days &gt; 60%; 2–4 minutes in app per day; Sean Ellis &gt; 40%&lt;br&gt;• Phase 3: the drift read is trusted and paid for; a channel partner signed or rejected with reasons; a seed round on evidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="12_Phase_0_four_weeks" name="12 · Phase 0 · four weeks"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Phase 0: prove the loop before building the app" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Founder: interviews, recruiting, ops. Co-founder: materials, prototype, metrics. Ticks live on the master plan page; this is the map." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Week 1 · survey out, first interviews&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Week 2 · interviews, close pilot families&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Week 3 · pilot live&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Week 4 · measure and decide&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c7" value="FOUNDER" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1320" height="300" as="geometry"/></mxCell><mxCell id="c8" value="CO-FOUNDER (AI)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1320" height="300" as="geometry"/></mxCell><mxCell id="c9" value="• Create the Telegram bot, Cloudflare account, Anthropic key (20 min)&lt;br&gt;• Decide repo visibility&lt;br&gt;• Post the survey in three places today&lt;br&gt;• Book 8 interviews&lt;br&gt;• Show your parent a mock of the arrival; write down her words" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c10" value="• Interviews 9–16, each ending with the pilot offer ($15, refundable)&lt;br&gt;• 10 families confirmed: eldest + organiser + one under-30&lt;br&gt;• Collect messengers, wake times, two nearby contacts each" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c11" value="• Onboard 10–15 families; parent call yourself for the first five&lt;br&gt;• Daily 15-minute check; log false notices and complaints&lt;br&gt;• Write the weekly read by hand on Sunday&lt;br&gt;• Interview anyone who declined or dropped" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c12" value="• Day-14 check-in: “If Vela stopped tomorrow…”&lt;br&gt;• Ask each parent: do you like getting this in the morning?&lt;br&gt;• Two introductions from each paying family&lt;br&gt;• Decision: build the MVP or change one variable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c13" value="• Survey intro and posts for all-families framing&lt;br&gt;• Prototype: family content in the arrival, quiet notice to the child, away mode&lt;br&gt;• Landing page with waitlist and two price points&lt;br&gt;• Weekly review template, decisions log" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c14" value="• Deploy the prototype; 3-day test with the founder's parent&lt;br&gt;• Onboarding script (5 min child, 5 min parent)&lt;br&gt;• Interview synthesis: objections, yes-reasons, prices, wish/worry" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="490" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c15" value="• Run the loop daily; tune quiet times&lt;br&gt;• Daily metrics: answer rate, latency, family-content days, notices and whether true, opt-outs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c16" value="• Phase-0 report and MVP scope cut to what was proven&lt;br&gt;• Pitch deck v1 from evidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Kill signals:&lt;/b&gt; fewer than 4 families paying after 20 interviews · more than 30% of parents refusing or going silent in week one for reasons other than being away · family-content days under 30% by week two despite prompts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1320" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="13_Metrics" name="13 · Metrics"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What we measure, and the 90-day targets" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The precision number is the one nobody else publishes." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Kept-light answer rate&lt;/b&gt;&lt;br&gt;Is she opening it with joy?&lt;br&gt;&lt;b&gt;target: &gt; 85%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="248" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Median answer latency&lt;/b&gt;&lt;br&gt;Habit; feeds quiet tuning&lt;br&gt;&lt;b&gt;target: &lt; 60 min&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="308" y="110" width="248" height="100" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Family-content days&lt;/b&gt;&lt;br&gt;Is the family present, or is Vela carrying it?&lt;br&gt;&lt;b&gt;target: &gt; 60%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="576" y="110" width="248" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Members / active contributors per family&lt;/b&gt;&lt;br&gt;Growth engine&lt;br&gt;&lt;b&gt;target: ≥ 5 / ≥ 3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="110" width="248" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Under-30 member in family&lt;/b&gt;&lt;br&gt;Is “closer” landing with the young?&lt;br&gt;&lt;b&gt;target: 60% of families&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1112" y="110" width="248" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Quiet notices per member per month; share true&lt;/b&gt;&lt;br&gt;Precision, published&lt;br&gt;&lt;b&gt;target: &lt; 2; &gt; 50%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="248" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Light conversion after trial; D90 retention&lt;/b&gt;&lt;br&gt;The business&lt;br&gt;&lt;b&gt;target: &gt; 25%; &gt; 80%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="308" y="226" width="248" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;“Stop” rate among kept-light members&lt;/b&gt;&lt;br&gt;Dignity&lt;br&gt;&lt;b&gt;target: &lt; 5%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="576" y="226" width="248" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Minutes in app per member per day&lt;/b&gt;&lt;br&gt;The anti-addiction promise&lt;br&gt;&lt;b&gt;target: 2–4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="844" y="226" width="248" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;“If Vela stopped tomorrow…” very disappointed&lt;/b&gt;&lt;br&gt;Product-market fit&lt;br&gt;&lt;b&gt;target: &gt; 40%&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1112" y="226" width="248" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;How they're computed&lt;/b&gt;&lt;br&gt;A nightly KPI job reads the append-only events table, never the live tables, and writes metrics_daily. Quiet-notice precision comes from quiet_events.outcome recorded by the organiser, not from any model. Reported weekly on the master plan page." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="14_Risks" name="14 · Risks"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Risks, named now" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Each with its mitigation. Reviewed at every phase exit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;The family goes quiet after week three, like every group chat&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Turns, prompts from their own words, the under-30 contributor, the Vela fallback; family-content days reviewed weekly as a bug when they drop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;The eldest feels watched&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Symmetry, “stop”, story day, everything arrives from people; ask her directly at week two" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;The young see it as their parents' app&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; The closeness promise is theirs; own flame on their terms; tested with under-30s in phase 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="110" width="425" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;We become a free messenger with 1% conversion&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Free layer is one moment a day, not chat; paid layer is silence semantics; move the line if conversion &lt; 25% at 90 days" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;False quiet notices erode trust&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Per-person tuning, away mode, never before +4 h, published precision, notice as information not alarm" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Messenger platform risk&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Adapters; never single-channel in a market; the app and the voice line as floors" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="246" width="425" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;A kept-light member is found late despite Vela&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Honest promise from day one; the language written before the first customer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="425" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Data law (Russia localisation, GDPR, PDPA)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; Minimum data, per-region storage, legal review per market" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="487" y="382" width="425" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Solo non-technical founder; consumer AgeTech funding down 48% in 2026&lt;/b&gt;&lt;br&gt;&lt;b&gt;Mitigation:&lt;/b&gt; AI co-founder builds; prototype exists; revenue from day one; a human technical co-founder from the batch or network" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="934" y="382" width="425" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="15_Decisions" name="15 · Decisions"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Decisions log" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Append, never rewrite. Architecture decisions with rejected alternatives are in architecture/decisions.md." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Research before anything. Six reports across US, Europe, East Asia, sensing, AI apps, market size; a seventh on family-bridge apps." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="650" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Repo on GitHub, near-zero budget. Free tiers only." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="650" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · Don't deploy the bot before talking to customers. Built as a probe, parked until interviews say what the probe should be." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="192" width="650" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · No human welfare-check ladder, no partners. The family acts on silence; Vela informs and shows who is nearby." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="192" width="650" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · All families, not diaspora only. Diaspora remains the first wedge." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="650" height="70" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-11&lt;/span&gt; · ikigai Launchpad application submitted ($100k for 8% SAFE, Taipei, 12 weeks)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="274" width="650" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · One app for three generations. Free daily thread for everyone; paid Light for any kept-light member; the eldest joins by messenger and may graduate to a parent surface." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="650" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Pricing to test: free + Light at $9.99/mo or $79/yr per kept-light member." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="356" width="650" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Phase 0 before the app. Prove the loop with the prototype and 10–20 paying three-generation families." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="650" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · English first. All copy, wireframes, bot defaults, and documents authored in English; Russian and Chinese are localisations." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="438" width="650" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · The master plan page's checklist is the one task tracker. Asana CSV as optional export; Trello dropped." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="650" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;color:#7d8794;font-family:monospace&quot;&gt;2026-09-12&lt;/span&gt; · Architecture: Cloudflare Workers + Postgres per region + adapters; flame lights before AI; gateway enforces the budget; Stripe first, IAP in phase 2; Russia = legal review before launch." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="520" width="650" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Open for decision (founder)&lt;/b&gt;&lt;br&gt;• Company jurisdiction: Delaware if ikigai says yes, otherwise Estonia for cost; affects Stripe, store accounts, data residency&lt;br&gt;• Payments: confirm Stripe web checkout first, in-app purchases in phase 2&lt;br&gt;• Data residency: EU default, APAC for Taiwan; Russian localisation law reviewed by a lawyer before any Russian launch&lt;br&gt;• Brand: check vela.app and close domains, trademark conflicts in the first markets" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1320" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>