html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="442" width="160" height="26" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Where the money goes&lt;/b&gt;&lt;br&gt;• AI is the dominant cost and the first thing to optimise: cheaper models for translation and prompts, cached system prompts, batched weekly reads&lt;br&gt;• Infrastructure stays under 2% of revenue at every scale&lt;br&gt;• Messaging is free on Telegram and cents on WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="640" height="120" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Open technical questions&lt;/b&gt;&lt;br&gt;• Speech-to-text provider: accuracy for elderly Russian and Mandarin speech; decide in phase 1&lt;br&gt;• WhatsApp template classification for a daily arrival; test with Meta before the Philippines launch&lt;br&gt;• MAX bot API maturity and data retention terms&lt;br&gt;• Voice-line carrier coverage in Russia and Taiwan; Expo web on old tablets for kitchen-table mode" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="488" width="640" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_6_Architecture_decisions" name="4.6 · Architecture decisions"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Architecture decision records" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="architecture/decisions.md. Each with what we rejected and what would make us revisit." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="#" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="60" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Decision" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Why" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="400" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Rejected" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="300" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Revisit if" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="110" width="230" height="24" as="geometry"/></mxCell><mxCell id="c8" value="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="60" height="49" as="geometry"/></mxCell><mxCell id="c9" value="Backend on Cloudflare Workers (Cron, Queues, R2, Hyperdrive), not a container service" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="134" width="330" height="49" as="geometry"/></mxCell><mxCell id="c10" value="Zero servers; free tier through phase 1; edge latency for webhooks; the prototype is already there; one deployable for a solo builder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="134" width="400" height="49" as="geometry"/></mxCell><mxCell id="c11" value="Node on Fly/Railway; Supabase functions; Lambda" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="134" width="300" height="49" as="geometry"/></mxCell><mxCell id="c12" value="Long-running audio work or CPU limits bite; then move the AI worker only" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="134" width="230" height="49" as="geometry"/></mxCell><mxCell id="c13" value="2" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="183" width="60" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Postgres (Neon) as system of record, one project per region" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="183" width="330" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Relational fit; branches for free staging; residency by config; D1 too small" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="183" width="400" height="36" as="geometry"/></mxCell><mxCell id="c16" value="D1 (prototype only); Firestore; Mongo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="183" width="300" height="36" as="geometry"/></mxCell><mxCell id="c17" value="A market requires in-country hosting Neon lacks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="183" width="230" height="36" as="geometry"/></mxCell><mxCell id="c18" value="3" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="60" height="36" as="geometry"/></mxCell><mxCell id="c19" value="One Expo codebase; the parent surface is a mode, not an app" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="219" width="330" height="36" as="geometry"/></mxCell><mxCell id="c20" value="One codebase; EAS; a separate parent app doubles listings and support while she rarely installs anyway" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="219" width="400" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Flutter; two apps; native" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="219" width="300" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Kitchen-table mode performs badly on old tablets" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="219" width="230" height="36" as="geometry"/></mxCell><mxCell id="c23" value="4" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="60" height="36" as="geometry"/></mxCell><mxCell id="c24" value="Parent side is adapters behind one interface; never one messenger" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="255" width="330" height="36" as="geometry"/></mxCell><mxCell id="c25" value="WhatsApp blocked in Russia, Telegram throttled, MAX state-run, LINE owns Taiwan; a platform dependency is a company risk" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="255" width="400" height="36" as="geometry"/></mxCell><mxCell id="c26" value="Telegram-only; WhatsApp-only; a Vela-only parent app" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="255" width="300" height="36" as="geometry"/></mxCell><mxCell id="c27" value="Never; add adapters" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="255" width="230" height="36" as="geometry"/></mxCell><mxCell id="c28" value="5" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="291" width="60" height="26" as="geometry"/></mxCell><mxCell id="c29" value="The flame lights on the raw answer, before any AI" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="291" width="330" height="26" as="geometry"/></mxCell><mxCell id="c30" value="The safety promise must not depend on a model or a third-party API" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="291" width="400" height="26" as="geometry"/></mxCell><mxCell id="c31" value="Understand-then-light" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="291" width="300" height="26" as="geometry"/></mxCell><mxCell id="c32" value="—" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="291" width="230" height="26" as="geometry"/></mxCell><mxCell id="c33" value="6" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="317" width="60" height="36" as="geometry"/></mxCell><mxCell id="c34" value="Notification budget enforced in one outbound gateway" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="317" width="330" height="36" as="geometry"/></mxCell><mxCell id="c35" value="The anti-addiction promise survives only if it is impossible to bypass in code" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="317" width="400" height="36" as="geometry"/></mxCell><mxCell id="c36" value="Per-feature discipline" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="317" width="300" height="36" as="geometry"/></mxCell><mxCell id="c37" value="—" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="317" width="230" height="36" as="geometry"/></mxCell><mxCell id="c38" value="7" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="353" width="60" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Residency by region; Russia as a legal review, not a technical bet" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="353" width="330" height="36" as="geometry"/></mxCell><mxCell id="c40" value="Minimum data reduces exposure; the founder cannot fund in-country infra now" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="353" width="400" height="36" as="geometry"/></mxCell><mxCell id="c41" value="Russian hosting from day one; ignoring it" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="353" width="300" height="36" as="geometry"/></mxCell><mxCell id="c42" value="Phase-1 exit, with a lawyer's opinion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="353" width="230" height="36" as="geometry"/></mxCell><mxCell id="c43" value="8" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="389" width="60" height="36" as="geometry"/></mxCell><mxCell id="c44" value="Claude via the API, structured outputs, versioned prompts, eval set; STT provider for voice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="389" width="330" height="36" as="geometry"/></mxCell><mxCell id="c45" value="Auditable, comparable across versions; safe prompt changes with real families" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="389" width="400" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Fine-tuning; self-hosted open model; free-text outputs" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="389" width="300" height="36" as="geometry"/></mxCell><mxCell id="c47" value="Cost at 10,000+ families; route by call type" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="389" width="230" height="36" as="geometry"/></mxCell><mxCell id="c48" value="9" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="60" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Stripe web checkout first; in-app purchases in phase 2" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="425" width="330" height="36" as="geometry"/></mxCell><mxCell id="c50" value="Avoids the 15–30% cut and review friction while testing prices; store rules require IAP once purchase is offered in-app" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="425" width="400" height="36" as="geometry"/></mxCell><mxCell id="c51" value="IAP from day one; never doing IAP" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="425" width="300" height="36" as="geometry"/></mxCell><mxCell id="c52" value="Phase 2 store launch" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="425" width="230" height="36" as="geometry"/></mxCell><mxCell id="c53" value="10" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="461" width="60" height="36" as="geometry"/></mxCell><mxCell id="c54" value="No human welfare-check operations inside Vela" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="100" y="461" width="330" height="36" as="geometry"/></mxCell><mxCell id="c55" value="Founder's decision; keeps Vela a software company; the family's own people are the scarce asset" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="461" width="400" height="36" as="geometry"/></mxCell><mxCell id="c56" value="Partner dispatch; Vela staff on the ladder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="461" width="300" height="36" as="geometry"/></mxCell><mxCell id="c57" value="—" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1130" y="461" width="230" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5_1_Business_model_and_pricing" name="5.1 · Business model and pricing"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Business model" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The free layer spreads; the light pays. Priced at the bottom of the $10–35 band because the payer is often young and the eldest's life is finite." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Vela · free · for everyone&lt;/b&gt;&lt;br&gt;• The daily moment, thread, turns, prompts, contributors, translation, story day&lt;br&gt;• Why free: contributors are the growth engine; ~8 relatives per paying family at Famileo; half of Aura's sales come from family invites&lt;br&gt;• Risk: becoming a free messenger with 1% conversion → the free layer is one moment a day, not chat" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="640" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Vela Light · $9.99/month or $79/year per kept-light member · +50% for a second&lt;/b&gt;&lt;br&gt;• The flame, quiet notices, nearby contacts, away mode, weekly read, memory, archive export, drift&lt;br&gt;• Why paid: people pay for the meaning of silence; Snug's $19.99 tier sells exactly this&lt;br&gt;• Trial: 30 days of Light after the first answer, so a family sees one weekly read or one quiet notice before paying&lt;br&gt;• To test in 90 days: $9.99 vs $14.99 vs annual-only; move the line if conversion &lt; 25%" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="640" height="190" as="geometry"/></mxCell><mxCell id="c5" value="Comparables and price anchors" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Product" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="240" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Price" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="350" width="220" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Signal" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="400" height="24" as="geometry"/></mxCell><mxCell id="c9" value="What it tells us" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="460" height="24" as="geometry"/></mxCell><mxCell id="c10" value="Famileo (printed family gazette)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="240" height="36" as="geometry"/></mxCell><mxCell id="c11" value="£5.99–17.99/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="374" width="220" height="36" as="geometry"/></mxCell><mxCell id="c12" value="260k families; €14M revenue 2024; profitable" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="374" width="400" height="36" as="geometry"/></mxCell><mxCell id="c13" value="Families pay this much to deliver love to a grandparent, with no safety layer at all" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="374" width="460" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Snug Dispatch (alert tier)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="240" height="26" as="geometry"/></mxCell><mxCell id="c15" value="$19.99/mo or $199.99/yr" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="410" width="220" height="26" as="geometry"/></mxCell><mxCell id="c16" value="The free tap is free; the alert sells" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="410" width="400" height="26" as="geometry"/></mxCell><mxCell id="c17" value="The top of our range; the ladder is what people pay for" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="460" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Docomo Chikaku (TV box for parents)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="240" height="26" as="geometry"/></mxCell><mxCell id="c19" value="¥1,980/mo (~$13)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="436" width="220" height="26" as="geometry"/></mxCell><mxCell id="c20" value="Sold in every Docomo shop; Aflac invested" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="436" width="400" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Warm content + presence at ~$13 works through a telco channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="436" width="460" height="26" as="geometry"/></mxCell><mxCell id="c22" value="ViewClix (family frame)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="240" height="26" as="geometry"/></mxCell><mxCell id="c23" value="$9.95/mo per family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="462" width="220" height="26" as="geometry"/></mxCell><mxCell id="c24" value="One fee for the whole family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="462" width="400" height="26" as="geometry"/></mxCell><mxCell id="c25" value="A per-family fee at $9.95 is accepted" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="462" width="460" height="26" as="geometry"/></mxCell><mxCell id="c26" value="Germany Hausnotruf" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="240" height="26" as="geometry"/></mxCell><mxCell id="c27" value="€25.50/mo reimbursed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="488" width="220" height="26" as="geometry"/></mxCell><mxCell id="c28" value="1.2M users; the market price by law" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="488" width="400" height="26" as="geometry"/></mxCell><mxCell id="c29" value="The public anchor for this outcome in Europe" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="488" width="460" height="26" as="geometry"/></mxCell><mxCell id="c30" value="Japan Post / Yamato / Zojirushi" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="240" height="26" as="geometry"/></mxCell><mxCell id="c31" value="¥1,070–3,300/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="514" width="220" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Families say they want ¥1,000–2,000" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="514" width="400" height="26" as="geometry"/></mxCell><mxCell id="c33" value="Japan's wanted price sits at our Light price" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="514" width="460" height="26" as="geometry"/></mxCell><mxCell id="c34" value="Marco Polo · Locket" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="26" as="geometry"/></mxCell><mxCell id="c35" value="$4–10/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="540" width="220" height="26" as="geometry"/></mxCell><mxCell id="c36" value="~1% of users pay for messaging" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="540" width="400" height="26" as="geometry"/></mxCell><mxCell id="c37" value="Never charge for messaging" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="540" width="460" height="26" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Unit economics&lt;/b&gt;&lt;br&gt;• No hardware; no staff on the ladder; AI ≈ $0.30–0.60 per kept-light member per month; infrastructure under 2% of revenue at every scale&lt;br&gt;• LTV capped at 2–4 years per kept-light member by her trajectory → acquisition must stay under $60 per family; the relationship must outlive one person (siblings, the second parent, the next generation)&lt;br&gt;• Acquisition plan: word of mouth inside families and communities; the under-30 member recruits; no paid ads before the referral loop works&lt;br&gt;• Payments: Stripe web checkout first; in-app purchases (RevenueCat) in phase 2 when store rules require it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="1320" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5_2_Revenue_scenarios" name="5.2 · Revenue scenarios"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Revenue scenarios (not forecasts)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Three paths with explicit assumptions. The point is to know which assumption we are testing at each phase." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Month" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="160" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Downside" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="300" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Base" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="300" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Upside" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="300" height="24" as="geometry"/></mxCell><mxCell id="c7" value="The assumption being tested" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="260" height="24" as="geometry"/></mxCell><mxCell id="c8" value="3 (end of phase 1)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="160" height="26" as="geometry"/></mxCell><mxCell id="c9" value="60 families · 15% Light · $9.99 → ~$90 MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="134" width="300" height="26" as="geometry"/></mxCell><mxCell id="c10" value="100 · 25% · $9.99 → ~$250 MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="134" width="300" height="26" as="geometry"/></mxCell><mxCell id="c11" value="150 · 35% · $9.99 → ~$520 MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="134" width="300" height="26" as="geometry"/></mxCell><mxCell id="c12" value="Do families pay after the trial?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="134" width="260" height="26" as="geometry"/></mxCell><mxCell id="c13" value="6 (end of phase 2)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="160" height="36" as="geometry"/></mxCell><mxCell id="c14" value="500 · 20% → ~$1.0k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="300" height="36" as="geometry"/></mxCell><mxCell id="c15" value="1,000 · 30% → ~$3.0k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="300" height="36" as="geometry"/></mxCell><mxCell id="c16" value="2,000 · 35% → ~$7.0k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="300" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Does the referral loop carry growth without ads?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="260" height="36" as="geometry"/></mxCell><mxCell id="c18" value="12 (end of phase 3)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="160" height="36" as="geometry"/></mxCell><mxCell id="c19" value="4,000 · 25% → ~$10k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="196" width="300" height="36" as="geometry"/></mxCell><mxCell id="c20" value="10,000 · 35% → ~$35k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="196" width="300" height="36" as="geometry"/></mxCell><mxCell id="c21" value="20,000 · 40% → ~$80k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="196" width="300" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Does the read (drift) get trusted and paid? Does a channel partner sign?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="196" width="260" height="36" as="geometry"/></mxCell><mxCell id="c23" value="24" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="160" height="36" as="geometry"/></mxCell><mxCell id="c24" value="15,000 · 30% → ~$45k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="232" width="300" height="36" as="geometry"/></mxCell><mxCell id="c25" value="50,000 · 40% · +10% second member → ~$220k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="232" width="300" height="36" as="geometry"/></mxCell><mxCell id="c26" value="120,000 · 45% → ~$540k MRR" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="232" width="300" height="36" as="geometry"/></mxCell><mxCell id="c27" value="Does a second market (Taiwan, Philippines) repeat the first?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="232" width="260" height="36" as="geometry"/></mxCell><mxCell id="c28" value="What moves the numbers" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c29" value="Lever" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="300" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Effect" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="318" width="500" height="24" as="geometry"/></mxCell><mxCell id="c31" value="Evidence or guess" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="318" width="520" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Light conversion after trial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="342" width="300" height="36" as="geometry"/></mxCell><mxCell id="c33" value="The single most important number; 25% base" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="342" width="500" height="36" as="geometry"/></mxCell><mxCell id="c34" value="Snug and Famileo suggest families pay when the paid thing is the alert or the artefact; guess until phase 1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="342" width="520" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Members per family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="300" height="36" as="geometry"/></mxCell><mxCell id="c36" value="More contributors → more content days → higher answer rate → higher conversion and retention" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="378" width="500" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Famileo ~8 MAU per paying family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="378" width="520" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Second kept-light member" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="300" height="26" as="geometry"/></mxCell><mxCell id="c39" value="+50% ARPU on families with two parents or a parent and a student abroad" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="414" width="500" height="26" as="geometry"/></mxCell><mxCell id="c40" value="Guess; the three-generation shape makes it common" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="414" width="520" height="26" as="geometry"/></mxCell><mxCell id="c41" value="Annual plan share" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="300" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Cash up front; lower churn" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="440" width="500" height="26" as="geometry"/></mxCell><mxCell id="c43" value="Careline365 and LiveLife use annual prepay to blunt the 2–4 year tenure" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="440" width="520" height="26" as="geometry"/></mxCell><mxCell id="c44" value="Channel partner (telco, remittance app)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="466" width="300" height="26" as="geometry"/></mxCell><mxCell id="c45" value="Lower CAC, bulk distribution, price pressure" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="466" width="500" height="26" as="geometry"/></mxCell><mxCell id="c46" value="Docomo/Chikaku; Western Union × AXA; Korea's municipal SaaS model" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="466" width="520" height="26" as="geometry"/></mxCell><mxCell id="c47" value="Reimbursement (DE, UK, JP)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="492" width="300" height="26" as="geometry"/></mxCell><mxCell id="c48" value="€25/mo per member paid by an insurer or council, if precision is published" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="492" width="500" height="26" as="geometry"/></mxCell><mxCell id="c49" value="Germany's code is exactly €25.50; UK re-tenders in 2027" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="492" width="520" height="26" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Runway logic&lt;/b&gt;&lt;br&gt;Costs are under $50/month until 1,000 families and under $500/month until 10,000; the founder's time is the only real cost. With $100k (ikigai) the plan funds a human technical co-founder and the first customer-facing hire through phase 2. Without it, phases 0–1 are still fully fundable on revenue and free tiers." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="538" width="1320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6_1_Markets_and_the_growth_loop" name="6.1 · Markets and the growth loop"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Go to market: four waves, one loop" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Where we start, why, and how a family spreads. Channel caution: WhatsApp blocked in Russia since Feb 2026, Telegram throttled, MAX leads reach." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Wave" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="90" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Who" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Why them" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="400" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Channel and size" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="500" height="24" as="geometry"/></mxCell><mxCell id="c7" value="1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="90" height="49" as="geometry"/></mxCell><mxCell id="c8" value="Russian-speaking families; sharpest pain among the ~600k who emigrated since 2022 and whose parents stayed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="134" width="330" height="49" as="geometry"/></mxCell><mxCell id="c9" value="The founder is one of them and can reach them; hard-currency payers; no product exists; Russian parents already use Telegram and MAX daily" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="134" width="400" height="49" as="geometry"/></mxCell><mxCell id="c10" value="Telegram relocation communities (Georgia, Serbia, Kazakhstan, Turkey, Cyprus, Thailand, Taiwan, Germany, Israel); personal network; parents via Telegram and MAX" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="134" width="500" height="49" as="geometry"/></mxCell><mxCell id="c11" value="2" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="183" width="90" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Taiwan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="183" width="330" height="36" as="geometry"/></mxCell><mxCell id="c13" value="Super-aged since 2025; the founder lives there; LINE is one adapter away" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="183" width="400" height="36" as="geometry"/></mxCell><mxCell id="c14" value="LINE; Taiwanese friends; university networks; Traditional Chinese app" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="183" width="500" height="36" as="geometry"/></mxCell><mxCell id="c15" value="3" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="90" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Philippines, India, Ukraine, Latin America" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="219" width="330" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Same family shape at scale; remittance apps already bill this customer monthly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="219" width="400" height="36" as="geometry"/></mxCell><mxCell id="c18" value="WhatsApp; 2.19M OFWs and $35.6B remittances; 18.5M Indians abroad and $135.5B; Remitly (9.3M active), Wise (15.5M), Paysend (10M), KoronaPay (26M transactions/yr)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="219" width="500" height="36" as="geometry"/></mxCell><mxCell id="c19" value="4" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="90" height="36" as="geometry"/></mxCell><mxCell id="c20" value="Germany, UK, Japan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="255" width="330" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Insurers and councils reimburse ~€25/mo for this outcome; no software-only entrant exists in those tenders" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="255" width="400" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Germany's €25.50 code; UK council re-tenders around the Jan 2027 PSTN switch-off; Japanese municipal emergency-call replacement; Australia's AT-HM provider list" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="255" width="500" height="36" as="geometry"/></mxCell><mxCell id="c23" value="The growth loop" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="321" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;A 20-year-old installs Vela&lt;/b&gt;&lt;br&gt;for his grandmother" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="361" width="260" height="80" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Invites his mother and aunt&lt;/b&gt;&lt;br&gt;contributors, free" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="380" y="361" width="260" height="80" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;The mother switches on the light&lt;/b&gt;&lt;br&gt;and pays" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="700" y="361" width="260" height="80" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;The aunt tells her own family&lt;/b&gt;&lt;br&gt;a new organiser" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1020" y="361" width="260" height="80" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c27" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="471"/><mxPoint x="190" y="471"/></Array></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Later channels&lt;/b&gt;&lt;br&gt;• Telcos and remittance apps that already bill this exact customer monthly (precedents: AXA × Western Union insurance inside transfers; Aflac invested in Chikaku)&lt;br&gt;• Employers of relocants (IT firms in Yerevan, Tbilisi, Almaty) as a benefit&lt;br&gt;• Insurers in Germany, the UK, Japan once precision is published&lt;br&gt;• Universities with international students (the student abroad keeps a light for his mother)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="501" width="640" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;What we don't do&lt;/b&gt;&lt;br&gt;• Paid ads before the referral loop works&lt;br&gt;• A single messenger in any market&lt;br&gt;• Care homes as a channel in CIS (no Famileo-style network exists there)&lt;br&gt;• Payer-only distribution (Papa lost ~36 contracts after one article); direct revenue always stays" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="501" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6_2_Channel_landscape" name="6.2 · Channel landscape"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Messengers and rails, by market" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="research/07 §4–5. The parent side is adapters, never one messenger." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Russia (Mediascope, 12+)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Date" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Telegram" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="280" height="24" as="geometry"/></mxCell><mxCell id="c6" value="MAX" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="280" height="24" as="geometry"/></mxCell><mxCell id="c7" value="WhatsApp" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="140" width="280" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Note" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="280" height="24" as="geometry"/></mxCell><mxCell id="c9" value="Jan 2026 monthly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="200" height="26" as="geometry"/></mxCell><mxCell id="c10" value="96.0M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="164" width="280" height="26" as="geometry"/></mxCell><mxCell id="c11" value="73.7M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="164" width="280" height="26" as="geometry"/></mxCell><mxCell id="c12" value="89.4M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="164" width="280" height="26" as="geometry"/></mxCell><mxCell id="c13" value="Before the WhatsApp block (11 Feb 2026)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="164" width="280" height="26" as="geometry"/></mxCell><mxCell id="c14" value="Mar 2026 monthly / daily" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="36" as="geometry"/></mxCell><mxCell id="c15" value="94.3M / 72.2M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="190" width="280" height="36" as="geometry"/></mxCell><mxCell id="c16" value="83.2M / 61.5M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="280" height="36" as="geometry"/></mxCell><mxCell id="c17" value="76.5M / 30.3M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="280" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Telegram leads daily habit; WhatsApp collapsing" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="190" width="280" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Jun 2026 monthly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="200" height="49" as="geometry"/></mxCell><mxCell id="c20" value="75.7M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="226" width="280" height="49" as="geometry"/></mxCell><mxCell id="c21" value="86.2M (#1)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="226" width="280" height="49" as="geometry"/></mxCell><mxCell id="c22" value="63.5M" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="226" width="280" height="49" as="geometry"/></mxCell><mxCell id="c23" value="MAX leads reach; Telegram throttled; MAX removed from app stores in June and sanctioned in July" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="226" width="280" height="49" as="geometry"/></mxCell><mxCell id="c24" value="65+ segment (unverified)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="200" height="49" as="geometry"/></mxCell><mxCell id="c25" value="74%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="275" width="280" height="49" as="geometry"/></mxCell><mxCell id="c26" value="39%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="275" width="280" height="49" as="geometry"/></mxCell><mxCell id="c27" value="78%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="275" width="280" height="49" as="geometry"/></mxCell><mxCell id="c28" value="Older users prefer WhatsApp as main messenger, read Telegram channels; re-check at Mediascope before a slide" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1080" y="275" width="280" height="49" as="geometry"/></mxCell><mxCell id="c29" value="Costs and rules" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="374" width="200" height="24" as="geometry"/></mxCell><mxCell id="c31" value="Cost" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="374" width="400" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Rules that affect the arrival" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="374" width="720" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Telegram Bot API" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="398" width="200" height="26" as="geometry"/></mxCell><mxCell id="c34" value="$0 per message (~30 msg/s)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="398" width="400" height="26" as="geometry"/></mxCell><mxCell id="c35" value="Buttons, voice both ways; bot can be added to a family group (privacy mode off); best fit for the prototype" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="398" width="720" height="26" as="geometry"/></mxCell><mxCell id="c36" value="WhatsApp Business API" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="200" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Utility $0.0014 (India) / $0.0034 (US) / $0.0077 (RoW) per template; marketing 3–8× more; ≈ $0.04–0.23 per family per month" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="424" width="400" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Template approval; the parent must have messaged the business first for free-form replies; a daily arrival risks the marketing category; unusable in Russia" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="424" width="720" height="36" as="geometry"/></mxCell><