94;" vertex="1" parent="1"><mxGeometry x="1190" y="110" width="90" height="24" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Phase 0 · prove the loop&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="40" as="geometry"/></mxCell><mxCell id="c16" value="Survey + 20 interviews · pilot 10–20 families, no app" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="90" height="44" as="geometry"/></mxCell><mxCell id="c17" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="278" y="160" width="24" height="24" as="geometry"/></mxCell><mxCell id="c18" value="Decision 12 Oct" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="306" y="158" width="220" height="30" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Phase 1 · MVP&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="150" height="40" as="geometry"/></mxCell><mxCell id="c20" value="App + Telegram/WhatsApp/LINE · 100 families · pricing test · Stripe" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="240" width="180" height="44" as="geometry"/></mxCell><mxCell id="c21" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="458" y="250" width="24" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Exit: conversion &gt; 25%, D30 &gt; 85%" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="486" y="248" width="220" height="30" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Phase 2 · the bridge&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="150" height="40" as="geometry"/></mxCell><mxCell id="c24" value="Parent surface, kitchen-table mode, grandchildren tools, translation, story day, memory, MAX, Viber · Taiwan on LINE · 1,000 families" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#e3f1ea;strokeColor=#2f7d5b;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="330" width="270" height="44" as="geometry"/></mxCell><mxCell id="c25" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="728" y="340" width="24" height="24" as="geometry"/></mxCell><mxCell id="c26" value="Exit: contributors ≥ 3, family-content &gt; 60%" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="756" y="338" width="220" height="30" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Phase 3 · the read&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="150" height="40" as="geometry"/></mxCell><mxCell id="c28" value="Drift with published precision, voice line, second-member plans · first channel partner · 10,000 families · seed on evidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="540" height="44" as="geometry"/></mxCell><mxCell id="c29" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e0a23a;strokeColor=#e0a23a;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1268" y="430" width="24" height="24" as="geometry"/></mxCell><mxCell id="c30" value="Exit: read trusted and paid" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1296" y="428" width="220" height="30" as="geometry"/></mxCell><mxCell id="c31" value="Phase" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="170" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Ships" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="520" width="560" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Families" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="520" width="130" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Exit test" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="520" width="460" height="24" as="geometry"/></mxCell><mxCell id="c35" value="0 · Prove the loop" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="544" width="170" height="36" as="geometry"/></mxCell><mxCell id="c36" value="No app. Eldest via the Telegram prototype; family in a Telegram group with Vela; each family with an under-30 member; weekly read written by hand" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="544" width="560" height="36" as="geometry"/></mxCell><mxCell id="c37" value="10–20 paying $15" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="544" width="130" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Answer rate &gt; 85%; family-content days &gt; 30% by week two; ≥ 4 families paying; parents not refusing" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="544" width="460" height="36" as="geometry"/></mxCell><mxCell id="c39" value="1 · MVP" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="170" height="36" as="geometry"/></mxCell><mxCell id="c40" value="The app: setup, flames, thread, queue, turns, prompts, quiet notice, away mode, weekly read, Light subscription; Telegram + WhatsApp + LINE adapters; admin view" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="580" width="560" height="36" as="geometry"/></mxCell><mxCell id="c41" value="100" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="580" width="130" height="36" as="geometry"/></mxCell><mxCell id="c42" value="Light conversion &gt; 25%; D30 &gt; 85%; answer rate &gt; 85%; members per family ≥ 5" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="580" width="460" height="36" as="geometry"/></mxCell><mxCell id="c43" value="2 · The bridge" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="170" height="49" as="geometry"/></mxCell><mxCell id="c44" value="Parent surface and kitchen-table mode; grandchildren tools; translation both ways; story day and archive; memory; MAX and Viber; referral loop; Taiwan on LINE; first customer-facing hire" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="616" width="560" height="49" as="geometry"/></mxCell><mxCell id="c45" value="1,000" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="616" width="130" height="49" as="geometry"/></mxCell><mxCell id="c46" value="Contributors ≥ 3; family-content days &gt; 60%; 2–4 minutes per day; Sean Ellis &gt; 40%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="616" width="460" height="49" as="geometry"/></mxCell><mxCell id="c47" value="3 · The read" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="665" width="170" height="36" as="geometry"/></mxCell><mxCell id="c48" value="Drift with published precision; voice/SMS line; second kept-light member plans; first channel partner (telco or remittance app); insurer conversation with precision numbers" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="665" width="560" height="36" as="geometry"/></mxCell><mxCell id="c49" value="10,000" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="665" width="130" height="36" as="geometry"/></mxCell><mxCell id="c50" value="The read is trusted and paid; a partner signed or rejected with reasons; a seed round on evidence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="665" width="460" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_2_Phase_0_four_weeks" name="7.2 · Phase 0 · four weeks"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Phase 0: prove the loop before building the app" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Founder: interviews, recruiting, ops. Co-founder: materials, prototype, metrics. Ticks live on the master plan page; this is the map." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Week 1 · survey out, first interviews&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Week 2 · interviews, close pilot families&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Week 3 · pilot live&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Week 4 · measure and decide&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="270" height="30" as="geometry"/></mxCell><mxCell id="c7" value="FOUNDER" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1320" height="300" as="geometry"/></mxCell><mxCell id="c8" value="CO-FOUNDER (AI)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1320" height="300" as="geometry"/></mxCell><mxCell id="c9" value="• Create the Telegram bot, Cloudflare account, Anthropic key (20 min)&lt;br&gt;• Decide repo visibility&lt;br&gt;• Post the survey in three places today&lt;br&gt;• Book 8 interviews&lt;br&gt;• Show your parent a mock of the arrival; write down her words" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="200" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c10" value="• Interviews 9–16, each ending with the pilot offer ($15, refundable)&lt;br&gt;• 10 families confirmed: eldest + organiser + one under-30&lt;br&gt;• Collect messengers, wake times, two nearby contacts each" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="490" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c11" value="• Onboard 10–15 families; parent call yourself for the first five&lt;br&gt;• Daily 15-minute check; log false notices and complaints&lt;br&gt;• Write the weekly read by hand on Sunday&lt;br&gt;• Interview anyone who declined or dropped" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c12" value="• Day-14 check-in: “If Vela stopped tomorrow…”&lt;br&gt;• Ask each parent: do you like getting this in the morning?&lt;br&gt;• Two introductions from each paying family&lt;br&gt;• Decision: build the MVP or change one variable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="270" height="260" as="geometry"/></mxCell><mxCell id="c13" value="• Survey intro and posts for the all-families framing&lt;br&gt;• Prototype: family content in the arrival, quiet notice to the child, away mode&lt;br&gt;• Landing page with waitlist and two price points&lt;br&gt;• Weekly review template, decisions log" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c14" value="• Deploy the prototype; 3-day test with the founder's parent&lt;br&gt;• Onboarding script (5 min child, 5 min parent)&lt;br&gt;• Interview synthesis: objections, yes-reasons, prices, wish/worry" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="490" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c15" value="• Run the loop daily; tune quiet times&lt;br&gt;• Daily metrics: answer rate, latency, family-content days, notices and whether true, opt-outs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="780" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c16" value="• Phase-0 report and MVP scope cut to what was proven&lt;br&gt;• Pitch deck v1 from evidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1070" y="500" width="270" height="260" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Kill signals:&lt;/b&gt; fewer than 4 families paying after 20 interviews · more than 30% of parents refusing or going silent in week one for reasons other than being away · family-content days under 30% by week two despite prompts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="640" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;What the interviews must answer&lt;/b&gt;&lt;br&gt;• Who do you wish you heard from more? Who do you worry about when quiet?&lt;br&gt;• What do you send today, and why does it stop?&lt;br&gt;• Who near her would you trust to knock? Names, not categories.&lt;br&gt;• Does “a morning from us on your behalf” feel like help or a lie?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="640" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_3_Phases_1_3_in_detail" name="7.3 · Phases 1–3 in detail"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What each phase builds, and what it must prove" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Scope is cut from what phase 0 proved; nothing here is sacred except the exit tests." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Phase" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="130" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Build (co-founder)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="110" width="420" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Do (founder)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="420" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Prove" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="350" height="24" as="geometry"/></mxCell><mxCell id="c7" value="1 · MVP · months 2–3" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="130" height="75" as="geometry"/></mxCell><mxCell id="c8" value="Expo app: setup, flames, thread, queue, turns, prompts, quiet notice with nearby contacts, away mode, weekly read, Light via Stripe · adapters: Telegram (from the prototype), WhatsApp, LINE · AI service with versioned prompts and logging · admin view · migrations, CI, staging" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="134" width="420" height="75" as="geometry"/></mxCell><mxCell id="c9" value="Convert phase-0 families to the app; recruit toward 100 through referrals (two introductions per paying family); pricing test $9.99 vs $79/yr vs $14.99; ten more interviews with families who declined; Taiwan groundwork (five conversations); if ikigai says yes, the batch; if not, two more programmes with phase-0 data" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="134" width="420" height="75" as="geometry"/></mxCell><mxCell id="c10" value="Conversion &gt; 25%; D30 &gt; 85%; answer rate &gt; 85%; members per family ≥ 5" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="134" width="350" height="75" as="geometry"/></mxCell><mxCell id="c11" value="2 · The bridge · months 4–6" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="209" width="130" height="62" as="geometry"/></mxCell><mxCell id="c12" value="Parent surface and kitchen-table mode; grandchildren tools (draw, record with a parent's phone); translation both ways; story day and archive (PDF export); memory and reminders; MAX and Viber adapters; referral loop in the app; Traditional Chinese app; feature flags" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="209" width="420" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Taiwan launch on LINE; first hire: a customer-facing person who speaks the languages of the first 1,000 families; community; onboarding calls" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="209" width="420" height="62" as="geometry"/></mxCell><mxCell id="c14" value="1,000 families; contributors ≥ 3; family-content days &gt; 60%; 2–4 min/day; Sean Ellis &gt; 40%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="209" width="350" height="62" as="geometry"/></mxCell><mxCell id="c15" value="3 · The read · months 7–12" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="271" width="130" height="49" as="geometry"/></mxCell><mxCell id="c16" value="Drift with published precision; voice/SMS line for parents without smartphones; second kept-light member plans; in-app purchases (RevenueCat); data-residency review for a Russian launch; eval set at scale" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="170" y="271" width="420" height="49" as="geometry"/></mxCell><mxCell id="c17" value="First B2B2C conversation with a telco or remittance app; insurer conversation in Germany or Japan with precision numbers; seed round on evidence; second engineer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="271" width="420" height="49" as="geometry"/></mxCell><mxCell id="c18" value="10,000 families; the read trusted and paid; a partner signed or rejected with reasons" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="271" width="350" height="49" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Cadence&lt;/b&gt;&lt;br&gt;Monday: 30 minutes, three priorities each, in plan/weekly/. Daily in pilot weeks: a 15-minute check on the loop. Friday: written review with the metrics table; decisions appended to plan/decisions.md and to this file. Every phase exit is a written decision: continue, pivot one variable, or stop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="7_4_Metrics" name="7.4 · Metrics"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What we measure, and the 90-day targets" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The precision number is the one nobody else publishes." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Metric" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Why" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="420" height="24" as="geometry"/></mxCell><mxCell id="c5" value="90-day target" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="200" height="24" as="geometry"/></mxCell><mxCell id="c6" value="How it's computed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="360" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Kept-light answer rate" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="340" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Is she opening it with joy?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="380" y="134" width="420" height="36" as="geometry"/></mxCell><mxCell id="c9" value="&gt; 85%" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="134" width="200" height="36" as="geometry"/></mxCell><mxCell id="c10" 