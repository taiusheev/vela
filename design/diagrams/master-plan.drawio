verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="680" y="512" width="680" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Consent, by surface" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Moment" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="588" width="240" height="24" as="geometry"/></mxCell><mxCell id="c34" value="What is said, and by whom" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="588" width="540" height="24" as="geometry"/></mxCell><mxCell id="c35" value="What is recorded" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="588" width="540" height="24" as="geometry"/></mxCell><mxCell id="c36" value="Flame on, messenger" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="240" height="36" as="geometry"/></mxCell><mxCell id="c37" value="First message from Vela: “Anna would like to keep a light on for you: every morning something from the family, and if you don't answer, she'll know to call. Tap Yes or write no.”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="612" width="540" height="36" as="geometry"/></mxCell><mxCell id="c38" value="members.flame_consented_at, the consent text as an event, the channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="612" width="540" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Flame on, parent surface" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="648" width="240" height="26" as="geometry"/></mxCell><mxCell id="c40" value="A screen with the same words and two buttons" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="648" width="540" height="26" as="geometry"/></mxCell><mxCell id="c41" value="same" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="648" width="540" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Flame on, self" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="240" height="26" as="geometry"/></mxCell><mxCell id="c43" value="A member switches their own flame on (the student abroad)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="674" width="540" height="26" as="geometry"/></mxCell><mxCell id="c44" value="implicit consent; visible in their settings" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="674" width="540" height="26" as="geometry"/></mxCell><mxCell id="c45" value="Nearby contact" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="240" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Message from Vela on the organiser's behalf: who, why, what they may be asked, one tap to agree" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="700" width="540" height="36" as="geometry"/></mxCell><mxCell id="c47" value="nearby_contacts.consented_at; until then only the organiser may call them directly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="540" height="36" as="geometry"/></mxCell><mxCell id="c48" value="“What the family sees”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="736" width="240" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Any kept-light member asks in chat or taps the button: last 7 summary lines and the last weekly read" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="736" width="540" height="36" as="geometry"/></mxCell><mxCell id="c50" value="event; symmetry is a promise, not a setting" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="736" width="540" height="36" as="geometry"/></mxCell><mxCell id="c51" value="“Stop”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="772" width="240" height="36" as="geometry"/></mxCell><mxCell id="c52" value="Any refusal word in her language turns the flame off and pauses arrivals; the organiser is told without judgement" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="772" width="540" height="36" as="geometry"/></mxCell><mxCell id="c53" value="status paused; flame off; event" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="772" width="540" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_4_Closer_the_free_layer" name="3.4 · Closer: the free layer"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What makes the family closer (free, for everyone)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="These are the features that make the group chat look like what it is: chaos that goes quiet. Spec §7–10." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Feature" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="24" as="geometry"/></mxCell><mxCell id="c4" value="How it works" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="520" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Why, with evidence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="620" height="24" as="geometry"/></mxCell><mxCell id="c6" value="One moment a day, then closed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="180" height="36" as="geometry"/></mxCell><mxCell id="c7" value="Each member gets exactly one arrival at their hour and one turn prompt at most; the app has no feed, no badges, no other notifications" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="134" width="520" height="36" as="geometry"/></mxCell><mxCell id="c8" value="BeReal's core opens within 3 min of one daily push; Locket reached 80M downloads feed-free; the anti-addiction promise and the engagement design are the same thing" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="134" width="620" height="36" as="geometry"/></mxCell><mxCell id="c9" value="Turns" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="180" height="49" as="geometry"/></mxCell><mxCell id="c10" value="Round-robin among members who opted in (default all except kept-light), one per day, skipping days that already have queued content; prompt the evening before at 19:00 local; skipping has no consequence except the fallback" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="170" width="520" height="49" as="geometry"/></mxCell><mxCell id="c11" value="Five busy people produce a rhythm no single busy child can sustain; no guilt-tripping copy" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="620" height="49" as="geometry"/></mxCell><mxCell id="c12" value="Prompts that know the family" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="180" height="36" as="geometry"/></mxCell><mxCell id="c13" value="From the kept-light member's recent mentions, family dates, and the contributor's last item; one sentence, one concrete ask: “She mentioned the tomatoes; ask for a photo”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="219" width="520" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Kinsome does generic prompts; ours come from her own words; prompts are suggestions and never auto-sent as a person" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="219" width="620" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Grandchildren first-class" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="180" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Kids draw or record with a parent's phone; teens send a photo without writing; contributions are attributed to the child" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="255" width="520" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Famileo: grandchildren post the most; their content gets the strongest replies and is what the eldest keeps" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="255" width="620" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Translation both ways" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="291" width="180" height="49" as="geometry"/></mxCell><mxCell id="c19" value="Every item shown in the reader's language with the original one tap away; register preserved (address form, diminutives, the grandchild's tone); the model is told who speaks to whom" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="291" width="520" height="49" as="geometry"/></mxCell><mxCell id="c20" value="Reconnects families that lost a shared language (Russian grandmother, English-and-Chinese grandchild in Taipei); nobody offers it" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="291" width="620" height="49" as="geometry"/></mxCell><mxCell id="c21" value="Story day" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="49" as="geometry"/></mxCell><mxCell id="c22" value="Weekly (Sunday) question from a curated bank for kept-light members; answers transcribed, translated, kept in the archive unless she says “don't keep that one”; export to a PDF book in phase 2" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="340" width="520" height="49" as="geometry"/></mxCell><mxCell id="c23" value="Storyworth built a company on this alone; here it is one day in seven and gives her a reason to reply that is about her" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="620" height="49" as="geometry"/></mxCell><mxCell id="c24" value="Memory" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="389" width="180" height="49" as="geometry"/></mxCell><mxCell id="c25" value="AI extracts dated facts from answers (“doctor on Thursday”) and proposes a reminder to the relevant member; created only on a tap; surfaces in prompts and the weekly read; never shown to her as “we noticed”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="389" width="520" height="49" as="geometry"/></mxCell><mxCell id="c26" value="The family remembers more; she feels heard" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="389" width="620" height="49" as="geometry"/></mxCell><mxCell id="c27" value="Her side of the bridge" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="180" height="36" as="geometry"/></mxCell><mxCell id="c28" value="She can send anything to the family any time through the same chat; it lands in the thread, transcribed and translated" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="438" width="520" height="36" as="geometry"/></mxCell><mxCell id="c29" value="The channel is two-way; the morning is just the guaranteed moment" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="438" width="620" height="36" as="geometry"/></mxCell><mxCell id="c30" value="The safe place" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="474" width="180" height="26" as="geometry"/></mxCell><mxCell id="c31" value="No ads, no strangers, no discovery, no infinite scroll; stated on the landing page" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="474" width="520" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Positioning against social media; measured as 2–4 minutes in app per member per day" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="474" width="620" height="26" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Languages&lt;/b&gt;&lt;br&gt;MVP: English, Russian, Traditional Chinese. Phase 2: Ukrainian, Tagalog, Hindi, Spanish, Japanese, Korean, German. English is authored first; every string has a key; translations reviewed by a native speaker before a market launch." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_5_Calmer_Vela_Light" name="3.5 · Calmer: Vela Light"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What makes the family calmer (paid, per kept-light member)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Spec §4–5, §11. The paid reason is the meaning of silence and the read, never messaging." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Feature" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="180" height="24" as="geometry"/></mxCell><mxCell id="c4" value="How it works" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="520" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Rules" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="110" width="620" height="24" as="geometry"/></mxCell><mxCell id="c6" value="The flame" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="180" height="36" as="geometry"/></mxCell><mxCell id="c7" value="Her first answer of the day lights it on the family's home screen; that is the whole dashboard" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="134" width="520" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Lights on the raw answer before any AI; no scores, no charts" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="134" width="620" height="36" as="geometry"/></mxCell><mxCell id="c9" value="Quiet notice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="180" height="36" as="geometry"/></mxCell><mxCell id="c10" value="After her tuned window: last contact, usual time, yesterday's summary, nearby contacts with Call and Ask to check, She's away, Wait 2 hours" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="170" width="520" height="36" as="geometry"/></mxCell><mxCell id="c11" value="Never before +4 h; never during away; closes itself on any answer; everyone told is told it's fine; outcome recorded for precision" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="620" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Nearby contacts" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="180" height="36" as="geometry"/></mxCell><mxCell id="c13" value="Two people named at setup; consent once; one tap to call; one tap to ask them to check; optional auto-ask after T_auto if the organiser doesn't respond" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="206" width="520" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Never contacted for anything else; the family decides, Vela never knocks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="206" width="620" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Away mode" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="180" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Set by anyone, said in an answer (confirmed back), or learned after three recurrences (Sunday church)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="242" width="520" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Arrivals continue; repeats and notices pause; the single biggest false-alarm killer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="242" width="620" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Weekly read" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="278" width="180" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Sunday: answered N of 7; usual time and drift vs last week (only if &gt;30 min); topics; anything mentioned twice; voice-note length drift (only if &gt;40%); one suggestion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="278" width="520" height="36" as="geometry"/></mxCell><mxCell id="c20" value="“Later than usual”, never “concerning”; no scores; she can read it too" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="278" width="620" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Memory and reminders" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="314" width="180" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Dated facts from her answers become reminders to the right member on a tap" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="314" width="520" height="26" as="geometry"/></mxCell><mxCell id="c23" value="Never silent; appears as the family asking" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="314" width="620" height="26" as="geometry"/></mxCell><mxCell id="c24" value="Story archive export" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="26" as="geometry"/></mxCell><mxCell id="c25" value="The kept stories as a PDF book (phase 2); print partner optional (phase 3)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="340" width="520" height="26" as="geometry"/></mxCell><mxCell id="c26" value="She is the author; she can drop any story" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="620" height="26" as="geometry"/></mxCell><mxCell id="c27" value="Drift (phase 3)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="180" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Per-person baselines of latency, length, sentiment, vocabulary, topics; sustained change over 2–3 weeks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="366" width="520" height="36" as="geometry"/></mxCell><mxCell id="c29" value="Conservative thresholds; framed as “worth a call”; precision published" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="366" width="620" height="36" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Escalation flags (both layers)&lt;/b&gt;&lt;br&gt;• Health words: pain, fall, dizziness, chest, breathing, not eating&lt;br&gt;• Hopelessness or not wanting to live&lt;br&gt;• A stranger at the door; “the bank called”; a request for money&lt;br&gt;• On a flag: the organiser gets her words verbatim (the one place we quote, because the organiser must judge); the reply to her is calm and warm; nothing goes to nearby contacts automatically" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="640" height="140" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Vela's own replies to a kept-light member&lt;/b&gt;&lt;br&gt;• At most one warm acknowledgement per day, two sentences, at most one question, her language and address form&lt;br&gt;• Never medical advice; never continues into a conversation; a second message the same day gets a fixed sign-off or nothing&lt;br&gt;• Always honest if asked: “a helper Anna asked to say good morning”&lt;br&gt;• The phase-0 prototype allows four turns; the MVP allows one" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="422" width="640" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_6_Surfaces_and_channels" name="3.6 · Surfaces and channels"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Surfaces and channels" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The eldest never learns anything new. No family is told “your grandmother's messenger isn't supported”; no adapter, no launch in that market." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Surface" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="24" as="geometry"/></mxCell><mxCell id="c4" value="For whom" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="110" width="220" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Must" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="480" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Must not" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="420" height="24" as="geometry"/></mxCell><mxCell id="c7" value="The app (iOS, Android, web)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="200" height="36" as="geometry"/></mxCell><mxCell id="c8" value="Every member who can install" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="134" width="220" height="36" as="geometry"/></mxCell><mxCell id="c9" value="Flames and today's moment first; thread; queue; turns; own flame settings; language; invite" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="134" width="480" height="36" as="geometry"/></mxCell><mxCell id="c10" value="A feed; badge counts; anything that rewards frequent opening" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="134" width="420" height="36" as="geometry"/></mxCell><mxCell id="c11" value="Parent surface (same app, simplified)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="200" height="49" as="geometry"/></mxCell><mxCell id="c12" value="The eldest, when a child installs it on a visit" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="170" width="220" height="49" as="geometry"/></mxCell><mxCell id="c13" value="One screen: the arrival; one big answer button; voice reply; call the organiser; “what the family sees”; “stop”; 18 pt text, 64 pt buttons, 7:1 contrast; everything read aloud" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="480" height="49" as="geometry"/></mxCell><mxCell id="c14" value="Menus, settings, small text" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="170" width="420" height="49" as="geometry"/></mxCell><mxCell id="c15" value="Kitchen-table mode" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="200" height="36" as="geometry"/></mxCell><mxCell id="c16" value="An old phone or tablet on her table" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="219" width="220" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Cycle family photos when idle; wake to the arrival; tap anywhere to answer; large clock" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="219" width="480" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Notifications or sounds beyond a gentle chime at her hour" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="219" width="420" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Messenger (Telegram, MAX, WhatsApp, LINE, Viber)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="255" width="200" height="36" as="geometry"/></mxCell><mxCell id="c20" value="The eldest who won't install; casual members" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="255" width="220" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Arrival as one message; button where supported; any reply counts; commands in her language: stop, start, what does the family see" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="255" width="480" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Chat beyond the one acknowledgement; links to install anything" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="255" width="420" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Voice line and SMS (later)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="291" width="200" height="36" as="geometry"/></mxCell><mxCell id="c24" value="A parent with a landline" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="291" width="220" height="36" as="geometry"/></mxCell><mxCell id="c25" value="A call at her hour from a saved number; play the family's voice notes; “press 1 if you're fine, or just say something”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="291" width="480" height="36" as="geometry"/></mxCell><mxCell id="c26" value="Menus deeper than one level" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="291" width="420" height="36" as="geometry"/></mxCell><mxCell id="c27" value="Nearby contact" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="327" width="200" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Neighbour, relative in town" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="327" width="220" height="26" as="geometry"/></mxCell><mxCell id="c29" value="One message only when asked; consent once" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="327" width="480" height="26" as="geometry"/></mxCell><mxCell id="c30" value="Anything else, ever" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="327" width="420" height="26" as="geometry"/></mxCell><mxCell id="c31" value="Channel adapters" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="373" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="403" width="160" height="24" as="geometry"/></mxCell><mxCell id="c33" value="Where it matters" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="403" width="300" height="24" as="geometry"/></mxCell><mxCell id="c34" value="Technical notes" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="403" width="430" height="24" as="geometry"/></mxCell><mxCell id="c35" value="Risk and status" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="403" width="430" height="24" as="geometry"/></mxCell><mxCell id="c36" value="Telegram" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="427" width="160" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Russia (daily-reach leader: 72M daily, Mar 2026), CIS diaspora, Ukraine" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="427" width="300" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Free Bot API (~30 msg/s); inline buttons; voice both ways; the prototype bot is the first adapter" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="427" width="430" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Throttled in Russia since Feb 2026; calls blocked since Aug 2025; full block floated; never the only channel in Russia" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="427" width="430" height="36" as="geometry"/></mxCell><mxCell id="c40" value="MAX" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="463" width="160" height="36" as="geometry"/></mxCell><mxCell id="c41" value="Russia (monthly-reach leader since May/June 2026: 86.2M)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="463" width="300" height="36" as="geometry"/></mxCell><mxCell id="c42" value="Official bot and mini-app API (dev.max.ru); CRM integrations; agencies migrating bots from Telegram" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="463" width="430" height="36" as="geometry"/></mxCell><mxCell id="c43" value="State-run; age ID via Gosuslugi; assume every message is readable; required for Russian parents" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="463" width="430" height="36" as="geometry"/></mxCell><mxCell id="c44" value="WhatsApp Business API" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="499" width="160" height="36" as="geometry"/></mxCell><mxCell id="c45" value="Philippines, India, LatAm, Europe, US" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="499" width="300" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Cloud API; template messages outside the 24-h window; utility $0.0014–0.0077 per message; business verification; no bots in groups" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="499" width="430" height="36" as="geometry"/></mxCell><mxCell id="c47" value="Blocked in Russia since 11 Feb 2026; daily arrival may be classified as marketing: test with Meta before the Philippines launch" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="499" width="430" height="36" as="geometry"/></mxCell><mxCell id="c48" value="LINE" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="535" width="160" height="26" as="geometry"/></mxCell><mxCell id="c49" value="Taiwan, Japan, Thailand" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="535" width="300" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Messaging API; rich messages; the Taiwan launch channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeom