Cell><mxCell id="c45" value="turns" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="170" height="26" as="geometry"/></mxCell><mxCell id="c46" value="family_id · day · member_id · prompt_text · prompt_sent_at · fulfilled_item_id" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="545" width="620" height="26" as="geometry"/></mxCell><mxCell id="c47" value="Round-robin" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="545" width="530" height="26" as="geometry"/></mxCell><mxCell id="c48" value="subscriptions" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="571" width="170" height="26" as="geometry"/></mxCell><mxCell id="c49" value="id · family_id · payer_member_id · plan · kept_light_member_ids · status · trial_ends · provider_ref" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="571" width="620" height="26" as="geometry"/></mxCell><mxCell id="c50" value="Stripe now; RevenueCat later" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="571" width="530" height="26" as="geometry"/></mxCell><mxCell id="c51" value="events" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="597" width="170" height="26" as="geometry"/></mxCell><mxCell id="c52" value="id · at · family_id · member_id · type · payload" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="597" width="620" height="26" as="geometry"/></mxCell><mxCell id="c53" value="Append-only, partitioned monthly; every AI output with its input; every send; every tap" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="597" width="530" height="26" as="geometry"/></mxCell><mxCell id="c54" value="ai_calls" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="623" width="170" height="36" as="geometry"/></mxCell><mxCell id="c55" value="id · member_id · call · prompt_version · input_hash · input_ref · output · tokens_in · tokens_out · latency_ms · at" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="623" width="620" height="36" as="geometry"/></mxCell><mxCell id="c56" value="Inputs by reference, so retention applies once" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="623" width="530" height="36" as="geometry"/></mxCell><mxCell id="c57" value="media" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="659" width="170" height="26" as="geometry"/></mxCell><mxCell id="c58" value="id · family_id · uploader_id · kind · storage_key · duration_s · created_at" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="659" width="620" height="26" as="geometry"/></mxCell><mxCell id="c59" value="R2 per region" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="830" y="659" width="530" height="26" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Retention&lt;/b&gt;&lt;br&gt;answers 30 days rolling (except those kept as stories) · media with its answer · a left member 30 days · a deleted family within 24 h · a deceased member's family read-only for a year · a deletion is an event with a hash of what was deleted, so we can prove it without keeping it" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="1320" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_4_Security_privacy_failure_modes" name="4.4 · Security, privacy, failure modes"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Security and privacy architecture; failure modes" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Technical design §8–9. The flame lights on the raw answer, before any AI: nothing on the safety path depends on a model." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Area" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Decision" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Data residency" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="220" height="36" as="geometry"/></mxCell><mxCell id="c6" value="One Postgres project and one R2 bucket per region: eu (default), apac (Taiwan; later Japan, Korea), us. Family region set at creation. Russia's localisation law is a legal review before any Russian launch; the pilot stores minimal data in eu (ADR-7)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="134" width="1100" height="36" as="geometry"/></mxCell><mxCell id="c7" value="Encryption" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="220" height="26" as="geometry"/></mxCell><mxCell id="c8" value="TLS everywhere; Postgres and R2 encrypted at rest; media URLs signed, 15-minute expiry" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c9" value="Secrets" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="220" height="26" as="geometry"/></mxCell><mxCell id="c10" value="Worker secrets only; nothing in the repo; every webhook verified by signature or secret token" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="196" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c11" value="Minimum data" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="220" height="26" as="geometry"/></mxCell><mxCell id="c12" value="No health records, no location, no contact scraping. The AI sees the answer, the last three summaries, and the profile; never the whole thread" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="222" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c13" value="Consent records" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="220" height="26" as="geometry"/></mxCell><mxCell id="c14" value="members.flame_consented_at, nearby_contacts.consented_at, and the event that carried the consent text" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="248" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c15" value="Deletion" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="274" width="220" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Family cascade within 24 h; member left after 30 days; answers after 30 days; archive only if kept; deletion event with a hash" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="274" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c17" value="Access" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Admin view gated by a short allow-list; every admin read of a family is logged as an event visible to the organiser on request" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c19" value="What we never build" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="326" width="220" height="26" as="geometry"/></mxCell><mxCell id="c20" value="Location tracking, camera or microphone monitoring, contact-list upload, advertising identifiers, selling data" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="260" y="326" width="1100" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Failure modes, decided" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Failure" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="300" height="24" as="geometry"/></mxCell><mxCell id="c23" value="Effect" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="402" width="300" height="24" as="geometry"/></mxCell><mxCell id="c24" value="Handling" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="402" width="720" height="24" as="geometry"/></mxCell><mxCell id="c25" value="Messenger API down (Telegram throttled, WhatsApp outage)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="426" width="300" height="36" as="geometry"/></mxCell><mxCell id="c26" value="Arrival not delivered" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="426" width="300" height="36" as="geometry"/></mxCell><mxCell id="c27" value="Gateway retries 3× over 30 min; then undelivered, organiser told once; the ladder does not fire from our own outage" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="426" width="720" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Our Worker down at the arrival minute" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="300" height="26" as="geometry"/></mxCell><mxCell id="c29" value="Arrival late" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="462" width="300" height="26" as="geometry"/></mxCell><mxCell id="c30" value="Next cron tick catches up; UNIQUE(member_id, day) prevents doubles; &gt;3 h late carries “sorry this is late”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="462" width="720" height="26" as="geometry"/></mxCell><mxCell id="c31" value="Postgres unreachable" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="300" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Everything pauses" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="488" width="300" height="26" as="geometry"/></mxCell><mxCell id="c33" value="Webhooks get 503 (channels retry); cron ticks skip; admin alert" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="488" width="720" height="26" as="geometry"/></mxCell><mxCell id="c34" value="AI provider down" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="300" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Answers not understood" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="514" width="300" height="36" as="geometry"/></mxCell><mxCell id="c36" value="The flame still lights immediately; understanding runs when the queue drains; the family sees “Mom answered” with the media" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="514" width="720" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Duplicate webhook delivery" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="300" height="26" as="geometry"/></mxCell><mxCell id="c38" value="Duplicate answer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="550" width="300" height="26" as="geometry"/></mxCell><mxCell id="c39" value="answers.external_id unique per channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="550" width="720" height="26" as="geometry"/></mxCell><mxCell id="c40" value="Member's phone changes number" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="300" height="26" as="geometry"/></mxCell><mxCell id="c41" value="Channel link dead" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="576" width="300" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Detected on blocked/unreachable events; organiser told; re-invite flow" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="576" width="720" height="26" as="geometry"/></mxCell><mxCell id="c43" value="Wrong time zone" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="602" width="300" height="26" as="geometry"/></mxCell><mxCell id="c44" value="False quiet notice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="602" width="300" height="26" as="geometry"/></mxCell><mxCell id="c45" value="Tz set from the city, confirmed by the first three answer times; mismatch &gt;3 h triggers a check with the organiser" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="602" width="720" height="26" as="geometry"/></mxCell><mxCell id="c46" value="A flag missed by the model" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="300" height="36" as="geometry"/></mxCell><mxCell id="c47" value="A concern not escalated" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="628" width="300" height="36" as="geometry"/></mxCell><mxCell id="c48" value="The organiser still sees her words in the thread; the eval set tracks flag recall on every prompt change; the weekly read repeats anything mentioned twice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="628" width="720" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_5_Delivery_and_cost_at_scale" name="4.5 · Delivery and cost at scale"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Environme