n" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="695" width="620" height="26" as="geometry"/></mxCell><mxCell id="c78" value="Japan, 2024 (first full-year NPA count)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="721" width="400" height="49" as="geometry"/></mxCell><mxCell id="c79" value="76,020 died alone at home; 58,044 were 65+; 21,856 found after 8+ days; 4,538 (65+) found after a month" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="721" width="300" height="49" as="geometry"/></mxCell><mxCell id="c80" value="The outcome every adult child is imagining" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="721" width="620" height="49" as="geometry"/></mxCell><mxCell id="c81" value="Korea godoksa (lonely deaths)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="400" height="36" as="geometry"/></mxCell><mxCell id="c82" value="3,559 (2022) → 3,661 (2023), rising; isolated elders' suicide rate &gt;2.3× co-residing" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="770" width="300" height="36" as="geometry"/></mxCell><mxCell id="c83" value="Loneliness and safety are the same problem" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="770" width="620" height="36" as="geometry"/></mxCell><mxCell id="c84" value="Solo elders' isolation" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="400" height="36" as="geometry"/></mxCell><mxCell id="c85" value="&gt;10 h a day with nobody present; in the 90s cohort 82% of falls happened alone" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="806" width="300" height="36" as="geometry"/></mxCell><mxCell id="c86" value="Nobody is there; the family is the only signal" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="806" width="620" height="36" as="geometry"/></mxCell><mxCell id="c87" value="Emergency vs reassurance (France, 7M alarm calls)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="842" width="400" height="26" as="geometry"/></mxCell><mxCell id="c88" value="~2% emergencies; 98% reassurance and social" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="842" width="300" height="26" as="geometry"/></mxCell><mxCell id="c89" value="The daily job is reassurance; emergency is the rare exception" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="842" width="620" height="26" as="geometry"/></mxCell><mxCell id="c90" value="The other side of the family" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="888" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c91" value="Statistic" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="400" height="24" as="geometry"/></mxCell><mxCell id="c92" value="Value" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="918" width="300" height="24" as="geometry"/></mxCell><mxCell id="c93" value="Source" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="918" width="620" height="24" as="geometry"/></mxCell><mxCell id="c94" value="US family caregivers, 2025" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="400" height="36" as="geometry"/></mxCell><mxCell id="c95" value="63M (+20M in a decade); 59M care for adults; avg age 51; 3 in 5 women; 29% sandwich generation" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="942" width="300" height="36" as="geometry"/></mxCell><mxCell id="c96" value="AARP/NAC Caregiving in the US 2025" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="942" width="620" height="36" as="geometry"/></mxCell><mxCell id="c97" value="Long-distance caregivers" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="978" width="400" height="26" as="geometry"/></mxCell><mxCell id="c98" value="nearly 1 in 3; 47% among caregivers under 50" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="978" width="300" height="26" as="geometry"/></mxCell><mxCell id="c99" value="AARP/NAC 2025 (secondary summary)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="978" width="620" height="26" as="geometry"/></mxCell><mxCell id="c100" value="People living outside their birth country" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="400" height="36" as="geometry"/></mxCell><mxCell id="c101" value="~300M (2024); largest origins India, Mexico, Russia, China, Philippines" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="1004" width="300" height="36" as="geometry"/></mxCell><mxCell id="c102" value="UN DESA, IOM" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="1004" width="620" height="36" as="geometry"/></mxCell><mxCell id="c103" value="Russian speakers who left after Feb 2022" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="400" height="36" as="geometry"/></mxCell><mxCell id="c104" value="668k (2022) + 450k (2023); ~600k+ net abroad after returns" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="1040" width="300" height="36" as="geometry"/></mxCell><mxCell id="c105" value="Holod, MSK1" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="1040" width="620" height="36" as="geometry"/></mxCell><mxCell id="c106" value="Overseas Filipino workers · Indian diaspora" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="400" height="36" as="geometry"/></mxCell><mxCell id="c107" value="2.19M OFWs (2024), $35.6B remittances (2025) · 18.5M Indians abroad, $135.5B remittances (FY25)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="1076" width="300" height="36" as="geometry"/></mxCell><mxCell id="c108" value="PSA, BusinessWorld, IBEF" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="740" y="1076" width="620" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="1_3_The_worry_decomposed" name="1.3 · The worry, decomposed"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What “peace of mind” is actually made of" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Five layers on the child's side, four on the parent's. The product must answer both or fail on one." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The adult child" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Layer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="24" as="geometry"/></mxCell><mxCell id="c5" value="What the child is actually feeling" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="140" width="560" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Evidence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="600" height="24" as="geometry"/></mxCell><mxCell id="c7" value="The spike" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="164" width="160" height="36" as="geometry"/></mxCell><mxCell id="c8" value="“She didn't pick up.” Minutes to hours of rehearsing the worst case, then relief, then nothing learned." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="164" width="560" height="36" as="geometry"/></mxCell><mxCell id="c9" value="r/AgingParents is full of these; France: 98% of alarm calls are reassurance; every interviewee will have a story" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="164" width="600" height="36" as="geometry"/></mxCell><mxCell id="c10" value="The catastrophe" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="160" height="36" as="geometry"/></mxCell><mxCell id="c11" value="A fall or stroke, and nobody knows for a day, a week." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="560" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Japan: 21,856 found 8+ days after death (2024); 1 in 5 falls a long lie; mortality 12% → 67% by time to help" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="200" width="600" height="36" as="geometry"/></mxCell><mxCell id="c13" value="The slow slide" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="236" width="160" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Is she eating? Sadder? Forgetting? Will I notice too late?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="236" width="560" height="36" as="geometry"/></mxCell><mxCell id="c15" value="Korea: 34.8% of solo elders have no one to call when sick; every sensor company sells “routine drift”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="236" width="600" height="36" as="geometry"/></mxCell><mxCell id="c16" value="The helplessness" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="160" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Even if I knew something was wrong, what could I do from 8,000 km?" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="272" width="560" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Elders' own objection to sensors: “we don't know what we'd do if an alert fires”; scaled products all bolt a human onto the sensor" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="272" width="600" height="36" as="geometry"/></mxCell><mxCell id="c19" value="The guilt" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="160" height="26" as="geometry"/></mxCell><mxCell id="c20" value="I should call more. I'm not a good daughter." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="308" width="560" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Japanese families buy “after an accident” (34%); the purchase is often penance" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="308" width="600" height="26" as="geometry"/></mxCell><mxCell id="c22" value="The parent" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c23" value="The parent feels" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="400" height="24" as="geometry"/></mxCell><mxCell id="c24" value="Evidence" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="384" width="920" height="24" as="geometry"/></mxCell><mxCell id="c25" value="“I am not a patient. A pendant says I am.”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="408" width="400" height="36" as="geometry"/></mxCell><mxCell id="c26" value="87% of French families see telecare as a marker of dependency; US adoption flat at 9% of 65+ for a decade; 3 of 4 falls happen with the pendant off; “he'd rather stay on the floor for an hour”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="408" width="920" height="36" as="geometry"/></mxCell><mxCell id="c27" value="“Don't watch me.”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="444" width="400" height="36" as="geometry"/></mxCell><mxCell id="c28" value="Acceptance (Swiss national survey, n=1,211): wearables 81%, ambient sensors 59%, cameras 37%, bathroom cameras 29%; Yamato chose a light bulb because “sensors make elderly people feel watched”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="444" width="920" height="36" as="geometry"/></mxCell><mxCell id="c29" value="“I don't want to be a burden, but I am lonely.”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="400" height="26" as="geometry"/></mxCell><mxCell id="c30" value="NUGU's top use is companionship; Hyodol cut depression risk 36%; Snug's elders write “flooded with gratitude”; Famileo's grandparents keep the gazette" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="920" height="26" as="geometry"/></mxCell><mxCell id="c31" value="“Unknown numbers are spam.”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="506" width="400" height="26" as="geometry"/></mxCell><mxCell id="c32" value="Iamfine's own reviews; inTouch tester's mother: “I would feel terrible… they are not bothered about phoning me”; Korean elders resent “mechanical care”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="440" y="506" width="920" height="26" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;The insight that organises everything&lt;/b&gt;&lt;br&gt;&lt;b&gt;The spike happens because silence is ambiguous.&lt;/b&gt; Today, silence means “could be anything.”&lt;br&gt;Every product that ever delivered peace of mind did one thing: it made silence mean “nothing is wrong, because if it were, you'd know.”&lt;br&gt;Detection accuracy, hardware, and AI are just different ways of earning the right to say that. Vela earns it with the family's own daily touch and the parent's own answer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1320" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_1_How_the_world_solves_it_today" name="2.1 · How the world solves it today"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Eight approaches, and where each stalls" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Condensed from research/00-SYNTHESIS.md. Full player tables in research/01–07." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Approach" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="170" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Who, and scale" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c5" value="What works" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Where it fails" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Verdict" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="160" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Emergency pendants (PERS, telecare, Hausnotruf)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="170" height="49" as="geometry"/></mxCell><mxCell id="c9" value="Life Alert, Medical Guardian (600k+), Lifeline (900k+), Tunstall, Careium (500k); 16.2M users EU+NA; €3.9B Europe" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="134" width="330" height="49" as="geometry"/></mxCell><mxCell id="c10" value="24/7 human response in 14–60 s; reimbursement codes (Germany €25.50/mo; UK councils; Spain 934k public users)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="134" width="330" height="49" as="geometry"/></mxCell><mxCell id="c11" value="Stigma; 18% wear all day; 3 of 4 falls with it off; US adoption 9% for a decade; billing and cancellation the top complaint; no cross-border reach" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="134" width="330" height="49" as="geometry"/></mxCell><mxCell id="c12" value="Owns the 2% emergency job, fails the 98% reassurance job" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="134" width="160" height="49" as="geometry"/></mxCell><mxCell id="c13" value="Consumer wearables" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="183" width="170" height="62" as="geometry"/></mxCell><mxCell id="c14" value="Apple Watch (most-cited “medical alert” in US surveys), Pixel Watch, Galaxy Watch" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="183" width="330" height="62" as="geometry"/></mxCell><mxCell id="c15" value="No stigma, no fee, fall detection auto-on at 65+, Check In" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="183" width="330" height="62" as="geometry"/></mxCell><mxCell id="c16" value="18-h battery charged during night-time falls; 911-first (“call my daughter, not 911”); ~35% of Apple 911 calls unfounded in one county; no remote setup; useless with dementia" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="183" width="330" height="62" as="geometry"/></mxCell><mxCell id="c17" value="Great for the tech-comfortable 65–75; no caregiver layer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="183" width="160" height="62" as="geometry"/></mxCell><mxCell id="c18" value="Passive home sensors" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="245" width="170" height="49" as="geometry"/></mxCell><mxCell id="c19" value="Aloe Care, Envoy ($99/mo), People Power, Vayyar (radar), Nobi (€35M), Inspiren ($155M), Sensi ($98M)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="245" width="330" height="49" as="geometry"/></mxCell><mxCell id="c20" value="Solves non-wear; elder acceptance 59% for ambient sensors; investors fund it for facilities" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="245" width="330" height="49" as="geometry"/></mxCell><mxCell id="c21" value="Ten dead consumer brands (Lively, BeClose, Cherry Home, Hex, EchoCare, Tellus…); $40–100/mo + hardware; cameras toxic; nobody publishes precision" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="245" width="330" height="49" as="geometry"/></mxCell><mxCell id="c22" value="Technology is fine; standalone consumer hardware never worked" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="245" width="160" height="49" as="geometry"/></mxCell><mxCell id="c23" value="Zero-install utility signals" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="170" height="62" as="geometry"/></mxCell><mxCell id="c24" value="Zojirushi kettle (14k contracts since 2001), Yamato bulb + driver (~9k, ¥1,078), Japan Post visit, Kansai Electric meter (free), Shanghai water meters (9,113 homes), Seoul plugs (4k+)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="294" width="330" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Zero install, no Wi-Fi, no smartphone, culturally accepted, distributed by a trusted utility" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="294" width="330" height="62" as="geometry"/></mxCell><mxCell id="c26" value="30-minute resolution; “no activity for 24 h” is the only alert; country-locked; no child-facing layer; ~45 fragmented Japanese services" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="294" width="330" height="62" as="geometry"/></mxCell><mxCell id="c27" value="Right philosophy, wrong ceiling" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="294" width="160" height="62" as="geometry"/></mxCell><mxCell id="c28" value="AI voice check-in calls" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="170" height="62" as="geometry"/></mxCell><mxCell id="c29" value="Naver CareCall (30–50k users, 128+ municipalities, 96% answer rate, 44% fewer solitary deaths in served areas), SKT NUGU (17k), ElliQ ($85M, ~3k units), inTouch €29.90, AloneAssist $14.99, Nonni A$40" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="356" width="330" height="62" as="geometry"/></mxCell><mxCell id="c30" value="Cheapest thing that ever scaled; companionship framing reduces depression; voice AI cost collapsed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="356" width="330" height="62" as="geometry"/></mxCell><mxCell id="c31" value="Every deployment with numbers is paid by a government or operator; parents screen unknown numbers; “dystopian” press; CareCall missed “maybe I should just die”; no B2C retention published" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="356" width="330" height="62" as="geometry"/></mxCell><mxCell id="c32" value="The call is a signal and a relationship, not a product" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="356" width="160" height="62" as="geometry"/></mxCell><mxCell id="c33" value="Check-in apps" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="418" width="170" height="49" as="geometry"/></mxCell><mxCell id="c34" value="Snug (30M check-ins, ~5–10k daily actives, $12.50–19.99 dispatch tier), Iamfine ($14.99), Enrich LINE bot (8.9k users, only 26% over 65)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="418" width="330" height="49" as="geometry"/></mxCell><mxCell id="c35" value="Elders self-enrol and love it; the paid tier with a human check is what people praise" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="418" width="330" height="49" as="geometry"/></mxCell><mxCell id="c36" value="Tiny; nagging; free clones; bare pings attract the young; Alexa Together at $19.99 with Amazon's distribution was cancelled" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="418" width="330" height="49" as="geometry"/></mxCell><mxCell id="c37" value="Proof that elders accept a self-controlled daily ritual" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="418" width="160" height="49" as="geometry"/></mxCell><mxCell id="c38" value="Family-presence products" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="467" width="170" height="62" as="geometry"/></mxCell><mxCell id="c39" value="Famileo (260k paying families, €14M 2024, ~8 relatives per family), GrandPad ($299 + $40–59/mo), Aura (half of sales from family invites), Docomo Chikaku (¥1,980/mo), Storyworth (1M+ books)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="467" width="330" height="62" as="geometry"/></mxCell><mxCell id="c40" value="Parents love them; grandchildren post most; buyer ≠ user works; institutional channels (care homes, telco shops)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="467" width="330" height="62" as="geometry"/></mxCell><mxCell id="c41" value="Print or hardware; no idea whether grandma opened it; no signal semantics; no ladder" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="467" width="330" height="62" as="geometry"/></mxCell><mxCell id="c42" value="The one shape where the parent wants the daily touch" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="467" width="160" height="62" as="geometry"/></mxCell><mxCell id="c43" value="Family social networks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="529" width="170" height="49" as="geometry"/></mxCell><mxCell id="c44" value="Path, Cocoon, 23snaps (dead); Marco Polo (~$10M/yr after 9 iterations), Locket (80M downloads, 100k payers), BeReal (68% open within 3 min of the push)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="210" y="529" width="330" height="49" as="geometry"/></mxCell><mxCell id="c45" value="Small circles; one synchronous daily prompt gets extraordinary open rates" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="529" width="330" height="49" as="geometry"/></mxCell><mxCell id="c46" value="Die against the family group chat; messaging converts ~1% to paid; novelty decays without a reason" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="870" y="529" width="330" height="49" as="geometry"/></mxCell><mxCell id="c47" value="Borrow the one-moment mechanic; never be a messenger" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="529" width="160" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_2_Findings_by_region" name="2.2 · Findings by region"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="What each market taught us" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="From research/01 (US), 04 (Europe, ANZ, Israel), 03 (East Asia)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Market" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Who pays, how it's sold" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="380" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Numbers that matter" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="400" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Lesson for Vela" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="390" height="24" as="geometry"/></mxCell><mxCell id="c7" value="United States" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="150" height="49" as="geometry"/></mxCell><mxCell id="c8" value="DTC PERS at $25–50/mo; Medicaid waivers; Medicare Advantage supplemental (fragile: plans cutting benefits); retail (Best Buy/Lively, $800M acquisition, $475M impairment)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="134" width="380" height="49" as="geometry"/></mxCell><mxCell id="c9" value="9% adoption flat; buyer intent 22% (children) vs 9% (seniors); children choose the device in only 11% of purchases; ~$700M of PERS M&amp;A in 18 months" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="134" width="400" height="49" as="geometry"/></mxCell><mxCell id="c10" value="The child has the intent and no product; consolidation means incumbents won't innovate" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="134" width="390" height="49" as="geometry"/></mxCell><mxCell id="c11" value="Germany" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="183" width="150" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Pflegekasse reimburses exactly €25.50/mo for anyone with Pflegegrad 1+ living alone; ~95% via five welfare associations" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="183" width="380" height="36" as="geometry"/></mxCell><mxCell id="c13" value="~1.2M users; ~15% of 75+; startups (Patronus, Helfi-Ruf, Gisela) are private-pay outside the code" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="183" width="400" height="36" as="geometry"/></mxCell><mxCell id="c14" value="A software-only product with published precision could enter the reimbursement code" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="183" width="390" height="36" as="geometry"/></mxCell><mxCell id="c15" value="United Kingdom" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="219" width="150" height="49" as="geometry"/></mxCell><mxCell id="c16" value="Councils tender to Tunstall/Careium/Appello; 30–50% already private-pay; “private-pay pathways” as austerity bites" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="219" width="380" height="49" as="geometry"/></mxCell><mxCell id="c17" value="1.7–2M users; ~36% of 75+ (highest in Europe); PSTN switch-off Jan 2027 forces re-tendering; two deaths in 2023 from analogue failure" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="219" width="400" height="49" as="geometry"/></mxCell><mxCell id="c18" value="A forced replacement cycle in 2027; councils are rethinking" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="219" width="390" height="49" as="geometry"/></mxCell><mxCell id="c19" value="Spain · France · Nordics" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="268" width="150" height="49" as="geometry"/></mxCell><mxCell id="c20" value="ES: 934k publicly funded, user pays €0–12/mo; FR: &gt;900k, 50% tax credit, 10–12% of 75+; SE: municipal entitlement, ~215k alarms, 97% stationary" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="268" width="380" height="49" as="geometry"/></mxCell><mxCell id="c21" value="Median user: a woman 80+; annual attrition ~15–25% (death, care home); FR growth 2–3%/yr" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="268" width="400" height="49" as="geometry"/></mxCell><mxCell id="c22" value="Pre-dependency 70–80 is unserved everywhere; the 80+ woman is the incumbents' only customer" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="268" width="390" height="49" as="geometry"/></mxCell><mxCell id="c23" value="Japan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="317" width="150" height="62" as="geometry"/></mxCell><mxCell id="c24" value="Adult child buys; ~45 services; utilities bundle for retention (Kansai free, Chubu ¥550, au ¥539); Secom ¥3,300–5,170 + ¥48–195k setup" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="317" width="380" height="62" as="geometry"/></mxCell><mxCell id="c25" value="Home watch-over market ¥26.2bn (2020) → ¥38.1bn (2030), consumer segment only ¥5.2bn; usage ~4% of households with a separately-living elder; 34% adopt after an accident; 31% “don't understand the offerings”; wanted price ¥1–2k/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="317" width="400" height="62" as="geometry"/></mxCell><mxCell id="c26" value="Awareness and a family-facing layer are the gaps, not sensors; framing as “appropriate distance”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="317" width="390" height="62" as="geometry"/></mxCell><mxCell id="c27" value="Korea" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="379" width="150" height="49" as="geometry"/></mxCell><mxCell id="c28" value="The state pays; welfare-targeted (300k households on 응급안전안심); telco CSR (SKT, KT); Naver CareCall as municipal SaaS" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="379" width="380" height="49" as="geometry"/></mxCell><mxCell id="c29" value="CareCall 96% answer, ~90% satisfaction; Seoul plugs: 46,974 signals → 154 interventions (0.3%); Hyodol 12k dolls, −35.7% depression risk" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="379" width="400" height="49" as="geometry"/></mxCell><mxCell id="c30" value="Companionship framing works; municipal staff absorb alert noise; precision is the unsolved problem" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="379" width="390" height="49" as="geometry"/></mxCell><mxCell id="c31" value="China · Singapore · HK · Taiwan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="428" width="150" height="62" as="geometry"/></mxCell><mxCell id="c32" value="Community (社区) is the response layer; Shanghai water meters 9,113 homes in a year; HDB alert system 26.8k seniors; SCHSA Safety Bell 30 years; Taipei free systems for registered solitary elders" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="428" width="380" height="62" as="geometry"/></mxCell><mxCell id="c33" value="9073 model (90% home); consent forms explicitly collected; middle-income elders underserved everywhere" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="428" width="400" height="62" as="geometry"/></mxCell><mxCell id="c34" value="Piggyback on infrastructure; pair detection with a human response; the family is the emergency contact" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="428" width="390" height="62" as="geometry"/></mxCell><mxCell id="c35" value="Israel · Australia · NZ" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="150" height="49" as="geometry"/></mxCell><mxCell id="c36" value="IL: welfare-funded floor (Yad Sarah ~20k) + B2B hardware exporters (Essence, Vayyar); AU: Support at Home AT-HM scheme from Nov 2025; NZ: accredited suppliers price-capped NZ$13–15/wk" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="490" width="380" height="49" as="geometry"/></mxCell><mxCell id="c37" value="Israeli tech sells to operators, not families; AU ring-fences alarm funding; NZ consolidated to 5 firms" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="490" width="400" height="49" as="geometry"/></mxCell><mxCell id="c38" value="Registered-provider lists are a channel once precision is proven" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="970" y="490" width="390" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_3_Family_bridge_benchmarks" name="2.3 · Family-bridge benchmarks"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Products where a family sends presence to a grandparent" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="From research/07. These are our closest relatives; the lessons are direct." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Product" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="140" height="24" as="geometry"/></mxCell><mxCell id="c4" value="What it is" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="110" width="230" height="24" as="geometry"/></mxCell><mxCell id="c5" value="Price" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="110" width="180" height="24" as="geometry"/></mxCell><mxCell id="c6" value="Traction" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="110" width="330" height="24" as="geometry"/></mxCell><mxCell id="c7" value="Lesson" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="440" height="24" as="geometry"/></mxCell><mxCell id="c8" value="Famileo (FR)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="134" width="140" height="36" as="geometry"/></mxCell><mxCell id="c9" value="App → printed family gazette mailed to the grandparent; B2B via care homes" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="134" width="230" height="36" as="geometry"/></mxCell><mxCell id="c10" value="£5.99–17.99/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="134" width="180" height="36" as="geometry"/></mxCell><mxCell id="c11" value="260k subscribed families; ~2M MAU (~8 per family); €14M revenue 2024, profitable; 2,700 partner care homes" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="134" width="330" height="36" as="geometry"/></mxCell><mxCell id="c12" value="Buyer ≠ user design; physical proof of love beats a feed; founding insight: grandma was excluded from the family WhatsApp" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="134" width="440" height="36" as="geometry"/></mxCell><mxCell id="c13" value="GrandPad (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="140" height="36" as="geometry"/></mxCell><mxCell id="c14" value="Locked-down LTE tablet with a curated family circle" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="170" width="230" height="36" as="geometry"/></mxCell><mxCell id="c15" value="$299 + $40–59/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="170" width="180" height="36" as="geometry"/></mxCell><mxCell id="c16" value="Long-running; reviewers: “too darn expensive”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="330" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Price ceiling for hardware + service ~$40–60; closed circle blocks scams" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="170" width="440" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Aura (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="206" width="140" height="36" as="geometry"/></mxCell><mxCell id="c19" value="Premium frame, invite-only family network" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="206" width="230" height="36" as="geometry"/></mxCell><mxCell id="c20" value="$229, no subscription" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="206" width="180" height="36" as="geometry"/></mxCell><mxCell id="c21" value="6M app users; 784M photos in 2024; half of sales from family-invite networks" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="206" width="330" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Virality runs through the contributors, not the recipient" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="206" width="440" height="36" as="geometry"/></mxCell><mxCell id="c23" value="Docomo Chikaku (JP)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="242" width="140" height="49" as="geometry"/></mxCell><mxCell id="c24" value="Box that puts the family's videos on the parent's TV; presence sensor; “assurance mode”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="242" width="230" height="49" as="geometry"/></mxCell><mxCell id="c25" value="¥1,980/mo incl. data" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="242" width="180" height="49" as="geometry"/></mxCell><mxCell id="c26" value="Sold in every Docomo shop since 2024; ¥1.5B raised incl. Aflac Ventures; “3× in a year”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="242" width="330" height="49" as="geometry"/></mxCell><mxCell id="c27" value="Warm content + passive presence is our thesis at ~$13/mo; telco and insurer channel" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="242" width="440" height="49" as="geometry"/></mxCell><mxCell id="c28" value="Storyworth (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="291" width="140" height="49" as="geometry"/></mxCell><mxCell id="c29" value="Weekly email question → hardcover memoir; child buys, parent answers by email reply" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="291" width="230" height="49" as="geometry"/></mxCell><mxCell id="c30" value="$59–199/yr" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="291" width="180" height="49" as="geometry"/></mxCell><mxCell id="c31" value="1M+ books, 35M stories, bootstrapped since 2013" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="291" width="330" height="49" as="geometry"/></mxCell><mxCell id="c32" value="Gift-purchase model; one prompt a week via a channel the parent already uses; the parent is the author" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="291" width="440" height="49" as="geometry"/></mxCell><mxCell id="c33" value="Marco Polo (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="140" height="36" as="geometry"/></mxCell><mxCell id="c34" value="Async video messaging for small circles" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="340" width="230" height="36" as="geometry"/></mxCell><mxCell id="c35" value="$5–10/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="340" width="180" height="36" as="geometry"/></mxCell><mxCell id="c36" value="56M installs; profitable only in 2024 after 9 iterations; ~$10M/yr" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="340" width="330" height="36" as="geometry"/></mxCell><mxCell id="c37" value="Pure family messaging has a low ceiling; sell peace of mind, not messaging" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="340" width="440" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Locket (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="140" height="36" as="geometry"/></mxCell><mxCell id="c39" value="Photo straight to friends' home-screen widget" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="376" width="230" height="36" as="geometry"/></mxCell><mxCell id="c40" value="Gold ~$4/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="376" width="180" height="36" as="geometry"/></mxCell><mxCell id="c41" value="80M downloads, 9M DAU, 100k paying (~1%)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="376" width="330" height="36" as="geometry"/></mxCell><mxCell id="c42" value="Zero-effort receive; tiny circle; ~1% pay" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="376" width="440" height="36" as="geometry"/></mxCell><mxCell id="c43" value="BeReal" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="412" width="140" height="36" as="geometry"/></mxCell><mxCell id="c44" value="One daily notification, two-minute window" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="412" width="230" height="36" as="geometry"/></mxCell><mxCell id="c45" value="free" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="412" width="180" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Core users: 68% open within 3 min; 72% daily engagement" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="412" width="330" height="36" as="geometry"/></mxCell><mxCell id="c47" value="One fixed daily moment gets extraordinary open rates; decays without a reason" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="412" width="440" height="36" as="geometry"/></mxCell><mxCell id="c48" value="Snug Safety (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="140" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Daily “I'm OK” tap; misses alert contacts" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="448" width="230" height="36" as="geometry"/></mxCell><mxCell id="c50" value="free; Dispatch $19.99/mo" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="448" width="180" height="36" as="geometry"/></mxCell><mxCell id="c51" value="20–30M check-ins; elders self-enrol" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="448" width="330" height="36" as="geometry"/></mxCell><mxCell id="c52" value="The paid tier is exactly the ladder; validates the top of our price range" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="448" width="440" height="36" as="geometry"/></mxCell><mxCell id="c53" value="Enrich (JP)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="140" height="36" as="geometry"/></mxCell><mxCell id="c54" value="LINE bot sends “OK?” every 1–3 days" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="484" width="230" height="36" as="geometry"/></mxCell><mxCell id="c55" value="free" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="484" width="180" height="36" as="geometry"/></mxCell><mxCell id="c56" value="8,918 users; only 26% are 65+" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="484" width="330" height="36" as="geometry"/></mxCell><mxCell id="c57" value="A bare ping attracts the young; the sign of life must ride on content the elder wants" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="484" width="440" height="36" as="geometry"/></mxCell><mxCell id="c58" value="Kinsome (US)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="140" height="36" as="geometry"/></mxCell><mxCell id="c59" value="Kids ↔ grandparent via email/SMS, AI conversation starters" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="180" y="520" width="230" height="36" as="geometry"/></mxCell><mxCell id="c60" value="free; $4.99 planned" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="410" y="520" width="180" height="36" as="geometry"/></mxCell><mxCell id="c61" value="early" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="330" height="36" as="geometry"/></mxCell><mxCell id="c62" value="Recipient needs no app; AI prompts are reusable" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="440" height="36" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Five things to borrow&lt;/b&gt;&lt;br&gt;• Buyer ≠ user, and the recipient needs no app (Storyworth, Kinsome, Enrich, Famileo)&lt;br&gt;• One fixed daily moment, not a feed (BeReal, Storyworth)&lt;br&gt;• Contributor virality as the growth engine (Aura, Famileo)&lt;br&gt;• Price the escalation and the read, not the messaging (Snug, Chikaku)&lt;br&gt;• Institutional and channel distribution over ads (Famileo care homes, Docomo shops, remittance apps)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="576" width="640" height="150" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Five things to avoid&lt;/b&gt;&lt;br&gt;• Hardware (GrandPad, Skylight, Konnekt, Zojirushi: 14k in 23 years)&lt;br&gt;• Bare check-in pings (Enrich)&lt;br&gt;• A mechanical care voice (Korean elders' “기계적 돌봄”)&lt;br&gt;• Freemium messaging hoping for conversion (Marco Polo, Locket)&lt;br&gt;• Single-channel dependence in Russia (WhatsApp blocked, Telegram throttled, MAX state-run)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6e3e1;strokeColor=#b1413a;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="576" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_4_Ten_truths_and_positioning" name="2.4 · Ten truths and positioning"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Ten truths that hold in every country, and where Vela sits" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The truths decide the design; the matrix is the pitch slide." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="01 The buyer is not the user. The child pays; the parent tolerates. Products for the parent fail on compliance; products for the child fail on dignity." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="650" height="52" as="geometry"/></mxCell><mxCell id="c4" value="02 Two jobs, not one. Emergency (2%) and daily reassurance (98%). Amazon bundled them at $20 and cancelled; PERS sells only the first; the second has no owner." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="110" width="650" height="52" as="geometry"/></mxCell><mxCell id="c5" value="03 Zero-install wins; hardware-first dies. Every scaled product rode something already in the home." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="650" height="52" as="geometry"/></mxCell><mxCell id="c6" value="04 Silence needs a plan, not a notification. “We don't know what we'd do if an alert fires.”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="170" width="650" height="52" as="geometry"/></mxCell><mxCell id="c7" value="05 Precision is unsolved. 0.3% true positives in Seoul; ~80% of bed alarms false; nobody publishes. We will." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="650" height="52" as="geometry"/></mxCell><mxCell id="c8" value="06 Willingness to pay is $10–35/month everywhere: Germany €25.50, Japan ¥1–2k wanted, US $14.99–40." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="230" width="650" height="52" as="geometry"/></mxCell><mxCell id="c9" value="07 LTV is capped at 2–4 years by the eldest's trajectory; the relationship must outlive one person." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="650" height="52" as="geometry"/></mxCell><mxCell id="c10" value="08 The 70–80 pre-dependency segment is unserved and insulted by everything on offer." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="290" width="650" height="52" as="geometry"/></mxCell><mxCell id="c11" value="09 Distribution is the moat: utilities, telcos, post, councils, remittance apps. Payer channels are fragile (Papa lost ~36 contracts after one article)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="650" height="52" as="geometry"/></mxCell><mxCell id="c12" value="10 Content from family gets opened with joy; pings get ignored. Famileo and Storyworth vs Enrich and Iamfine." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="710" y="350" width="650" height="52" as="geometry"/></mxCell><mxCell id="c13" value="Positioning matrix" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Capability" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="300" height="24" as="geometry"/></mxCell><mxCell id="c15" value="Pendant" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="452" width="150" height="24" as="geometry"/></mxCell><mxCell id="c16" value="Sensor kit" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="452" width="150" height="24" as="geometry"/></mxCell><mxCell id="c17" value="AI call" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="452" width="150" height="24" as="geometry"/></mxCell><mxCell id="c18" value="Camera" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="452" width="150" height="24" as="geometry"/></mxCell><mxCell id="c19" value="Utility" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="452" width="150" height="24" as="geometry"/></mxCell><mxCell id="c20" value="Vela" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="452" width="270" height="24" as="geometry"/></mxCell><mxCell id="c21" value="Works if the parent won't wear anything" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="300" height="26" as="geometry"/></mxCell><mxCell id="c22" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="476" width="150" height="26" as="geometry"/></mxCell><mxCell id="c23" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="476" width="150" height="26" as="geometry"/></mxCell><mxCell id="c24" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="476" width="150" height="26" as="geometry"/></mxCell><mxCell id="c25" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="476" width="150" height="26" as="geometry"/></mxCell><mxCell id="c26" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="476" width="150" height="26" as="geometry"/></mxCell><mxCell id="c27" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="476" width="270" height="26" as="geometry"/></mxCell><mxCell id="c28" value="Zero hardware to start" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="502" width="300" height="26" as="geometry"/></mxCell><mxCell id="c29" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="502" width="150" height="26" as="geometry"/></mxCell><mxCell id="c30" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="502" width="150" height="26" as="geometry"/></mxCell><mxCell id="c31" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="502" width="150" height="26" as="geometry"/></mxCell><mxCell id="c32" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="502" width="150" height="26" as="geometry"/></mxCell><mxCell id="c33" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="502" width="150" height="26" as="geometry"/></mxCell><mxCell id="c34" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="502" width="270" height="26" as="geometry"/></mxCell><mxCell id="c35" value="Sees a bad day, not just a fall" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="528" width="300" height="26" as="geometry"/></mxCell><mxCell id="c36" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="528" width="150" height="26" as="geometry"/></mxCell><mxCell id="c37" value="partial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="528" width="150" height="26" as="geometry"/></mxCell><mxCell id="c38" value="partial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="528" width="150" height="26" as="geometry"/></mxCell><mxCell id="c39" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="528" width="150" height="26" as="geometry"/></mxCell><mxCell id="c40" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="528" width="150" height="26" as="geometry"/></mxCell><mxCell id="c41" value="✓ from her own words" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="528" width="270" height="26" as="geometry"/></mxCell><mxCell id="c42" value="Dignity, no stigma" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="554" width="300" height="36" as="geometry"/></mxCell><mxCell id="c43" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="554" width="150" height="36" as="geometry"/></mxCell><mxCell id="c44" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="554" width="150" height="36" as="geometry"/></mxCell><mxCell id="c45" value="✗ spam" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="554" width="150" height="36" as="geometry"/></mxCell><mxCell id="c46" value="✗✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="554" width="150" height="36" as="geometry"/></mxCell><mxCell id="c47" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="554" width="150" height="36" as="geometry"/></mxCell><mxCell id="c48" value="✓ elder-controlled; she sees what the family sees" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="554" width="270" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Silence has a plan" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="26" as="geometry"/></mxCell><mxCell id="c50" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="590" width="150" height="26" as="geometry"/></mxCell><mxCell id="c51" value="partial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="590" width="150" height="26" as="geometry"/></mxCell><mxCell id="c52" value="rare" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="590" width="150" height="26" as="geometry"/></mxCell><mxCell id="c53" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="590" width="150" height="26" as="geometry"/></mxCell><mxCell id="c54" value="partial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="590" width="150" height="26" as="geometry"/></mxCell><mxCell id="c55" value="✓ family acts; nearby contacts one tap away" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="590" width="270" height="26" as="geometry"/></mxCell><mxCell id="c56" value="Precision published" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="300" height="26" as="geometry"/></mxCell><mxCell id="c57" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="616" width="150" height="26" as="geometry"/></mxCell><mxCell id="c58" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="616" width="150" height="26" as="geometry"/></mxCell><mxCell id="c59" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="616" width="150" height="26" as="geometry"/></mxCell><mxCell id="c60" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="616" width="150" height="26" as="geometry"/></mxCell><mxCell id="c61" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="616" width="150" height="26" as="geometry"/></mxCell><mxCell id="c62" value="✓ monthly" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="616" width="270" height="26" as="geometry"/></mxCell><mxCell id="c63" value="Cross-border, multilingual" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="642" width="300" height="26" as="geometry"/></mxCell><mxCell id="c64" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="642" width="150" height="26" as="geometry"/></mxCell><mxCell id="c65" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="642" width="150" height="26" as="geometry"/></mxCell><mxCell id="c66" value="partial" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="642" width="150" height="26" as="geometry"/></mxCell><mxCell id="c67" value="✓" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="642" width="150" height="26" as="geometry"/></mxCell><mxCell id="c68" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="642" width="150" height="26" as="geometry"/></mxCell><mxCell id="c69" value="✓ core" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="642" width="270" height="26" as="geometry"/></mxCell><mxCell id="c70" value="Makes the family closer, not just informed" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="668" width="300" height="36" as="geometry"/></mxCell><mxCell id="c71" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="668" width="150" height="36" as="geometry"/></mxCell><mxCell id="c72" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="668" width="150" height="36" as="geometry"/></mxCell><mxCell id="c73" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="668" width="150" height="36" as="geometry"/></mxCell><mxCell id="c74" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="668" width="150" height="36" as="geometry"/></mxCell><mxCell id="c75" value="✗" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="668" width="150" height="36" as="geometry"/></mxCell><mxCell id="c76" value="✓ turns, grandchildren, translation, story day" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="668" width="270" height="36" as="geometry"/></mxCell><mxCell id="c77" value="Price to family, per month" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="704" width="300" height="26" as="geometry"/></mxCell><mxCell id="c78" value="$25–50" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="704" width="150" height="26" as="geometry"/></mxCell><mxCell id="c79" value="$40–100" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="704" width="150" height="26" as="geometry"/></mxCell><mxCell id="c80" value="$15–40" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="704" width="150" height="26" as="geometry"/></mxCell><mxCell id="c81" value="$0–45" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="704" width="150" height="26" as="geometry"/></mxCell><mxCell id="c82" value="$0–25" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="704" width="150" height="26" as="geometry"/></mxCell><mxCell id="c83" value="free + $9.99 Light" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#e3f1ea;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="704" width="270" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_1_The_family_and_the_two_promises" name="3.1 · The family and the two promises"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1091" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="One family, three generations, two promises" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The unit is the family, not a pair. Anyone the family worries about can carry a flame; it is opt-in and visible to them." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;The family's daily thread&lt;/b&gt;&lt;br&gt;one moment a day · no feed · no strangers · no ads · free&lt;br&gt;turns · prompts · grandchildren · translation · story day · memory" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="460" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Grandmother · 78 · lives alone&lt;/b&gt;&lt;br&gt;joins through her messenger; installs nothing&lt;br&gt;&lt;b&gt;flame on&lt;/b&gt;: her answer is the sign of life&lt;br&gt;story day makes her the author, not the patient" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="300" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Student · 20 · abroad&lt;/b&gt;&lt;br&gt;best contributor: a 10-second voice note gets the strongest reply&lt;br&gt;best recruiter: invites the family&lt;br&gt;&lt;b&gt;own flame, opt-in&lt;/b&gt;, while abroad, on his terms" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1040" y="110" width="300" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Parent · 45 · organiser · pays&lt;/b&gt;&lt;br&gt;both a child (of the 78-year-old) and a parent (of the 20-year-old)&lt;br&gt;sets up the family, names the nearby contacts&lt;br&gt;gets the flame, the weekly read, the quiet notice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="550" y="530" width="300" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Nearby contact · neighbour, cousin&lt;/b&gt;&lt;br&gt;consents once&lt;br&gt;called only when the light stays dark&lt;br&gt;never receives anything else" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="300" height="110" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c7" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Role" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="150" height="24" as="geometry"/></mxCell><mxCell id="c13" value="Typically" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="710" width="330" height="24" as="geometry"/></mxCell><mxCell id="c14" value="Installs" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="710" width="200" height="24" as="geometry"/></mxCell><mxCell id="c15" value="Pays" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="710" width="120" height="24" as="geometry"/></mxCell><mxCell id="c16" value="What they get" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="710" width="520" height="24" as="geometry"/></mxCell><mxCell id="c17" value="Member" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="734" width="150" height="36" as="geometry"/></mxCell><mxCell id="c18" value="Anyone in the family, any age" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="734" width="330" height="36" as="geometry"/></mxCell><mxCell id="c19" value="The app; or nothing (messenger bot)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="734" width="200" height="36" as="geometry"/></mxCell><mxCell id="c20" value="No" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="734" width="120" height="36" as="geometry"/></mxCell><mxCell id="c21" value="The daily moment, the thread, turns and prompts, translation, story day, memory" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="734" width="520" height="36" as="geometry"/></mxCell><mxCell id="c22" value="Organiser" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="150" height="49" as="geometry"/></mxCell><mxCell id="c23" value="The one who sets the family up; usually the 40–55-year-old in the middle" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="770" width="330" height="49" as="geometry"/></mxCell><mxCell id="c24" value="The app" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="770" width="200" height="49" as="geometry"/></mxCell><mxCell id="c25" value="Yes, if the family keeps a light on for someone" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="770" width="120" height="49" as="geometry"/></mxCell><mxCell id="c26" value="Everything, plus flames, quiet notices, weekly reads" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="770" width="520" height="49" as="geometry"/></mxCell><mxCell id="c27" value="Kept-light member" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#fbf0d8;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="819" width="150" height="36" as="geometry"/></mxCell><mxCell id="c28" value="The grandmother who lives alone; the student abroad; anyone the family chooses and who agrees" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="819" width="330" height="36" as="geometry"/></mxCell><mxCell id="c29" value="The app if they can; their messenger if not; a landline later" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="819" width="200" height="36" as="geometry"/></mxCell><mxCell id="c30" value="No" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="819" width="120" height="36" as="geometry"/></mxCell><mxCell id="c31" value="A daily arrival from people who love them; nothing to learn; the right to say “stop”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="819" width="520" height="36" as="geometry"/></mxCell><mxCell id="c32" value="Nearby contact" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="150" height="26" as="geometry"/></mxCell><mxCell id="c33" value="A neighbour, a relative in the same town" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="190" y="855" width="330" height="26" as="geometry"/></mxCell><mxCell id="c34" value="Nothing" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="855" width="200" height="26" as="geometry"/></mxCell><mxCell id="c35" value="No" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="855" width="120" height="26" as="geometry"/></mxCell><mxCell id="c36" value="One message, only when the light hasn't lit and the organiser asks; consents once" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="855" width="520" height="26" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Closer · free · for everyone&lt;/b&gt;&lt;br&gt;• One moment a day, then the app closes&lt;br&gt;• Turns: each member gets a day; a prompt arrives the evening before&lt;br&gt;• Prompts that know the family, drawn from what people actually said&lt;br&gt;• Grandchildren first-class: voice, drawing, photo without writing&lt;br&gt;• Translation both ways, keeping her form of address&lt;br&gt;• Story day: one question a week; her answers become a book&lt;br&gt;• Memory: the Thursday appointment, the exam, the neighbour's name" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="40" y="901" width="640" height="150" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Calmer · Vela Light · paid&lt;/b&gt;&lt;br&gt;• The flame: her daily answer lights it on the family's home screen&lt;br&gt;• Quiet notice to the organiser after her usual window (never before +4 h); nearby contacts one tap away&lt;br&gt;• Away mode: “going to my sister's until Sunday” pauses everything&lt;br&gt;• Weekly read: how she really is, in neutral words, from her own replies&lt;br&gt;• Memory and reminders, story archive export, later drift with published precision&lt;br&gt;• Nothing to install, wear, or charge. The family acts; Vela never knocks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="720" y="901" width="640" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_2_The_daily_loop" name="3.2 · The daily loop"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1076" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="The daily loop and the quiet ladder" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="product/03-product-spec.md §3–5. Silence only matters for members with a flame." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="THE FAMILY (any member, any time)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c4" value="VELA (scheduler + AI)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c5" value="THE KEPT-LIGHT MEMBER" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c6" value="THE ORGANISER (when the light stays dark)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#fbf0d8;strokeColor=#e0a23a;fontColor=#7d8794;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1320" height="130" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Queue something&lt;/b&gt;&lt;br&gt;voice · photo · drawing · question&lt;br&gt;for today or “whenever”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Evening before: turn prompt&lt;/b&gt;&lt;br&gt;“Tomorrow is Sam's day. She mentioned the tomatoes; ask for a photo.”" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="300" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Thread updates&lt;/b&gt;&lt;br&gt;her answer, transcribed and translated;&lt;br&gt;whoever's content she answered is told" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="280" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Compose the arrival (her hour)&lt;/b&gt;&lt;br&gt;1 queued for today · 2 queued “whenever” (max 2)&lt;br&gt;3 story question (story day) · 4 Vela fallback, signed as Vela&lt;br&gt;one photo visible · voice as voice · her language and address form" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="360" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Read the answer (after the flame lit)&lt;/b&gt;&lt;br&gt;transcribe · one neutral line · mood words · mentions&lt;br&gt;flag: none | escalate → organiser with her words&lt;br&gt;away detected? confirm back" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="340" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Flame lights&lt;/b&gt;&lt;br&gt;on the raw answer, before any AI&lt;br&gt;repeat and quiet cancelled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1060" y="290" width="280" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;+2.5 h, no answer:&lt;/b&gt; repeat once" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="440" y="350" width="220" height="40" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;One message&lt;/b&gt;&lt;br&gt;“Good morning, Mrs Ivanova…” + Mia's photo&lt;br&gt;[ ☀️ I'm fine ]  🎤   (or: reply with anything, even a heart)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="360" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;One easy answer&lt;/b&gt;&lt;br&gt;tap · heart · voice · text · photo; anything counts&lt;br&gt;“stop” turns the flame off; the organiser is told" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#e3f1ea;strokeColor=#2f7d5b;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="340" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Quiet notice · arrival + T_quiet&lt;/b&gt;&lt;br&gt;T_quiet = median latency (14 d) + 2 h, floor 4 h, cap 8 h&lt;br&gt;last contact · usual time · yesterday's words&lt;br&gt;[Call] [Ask to check] [She's away] [Wait 2 h]" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="680" y="650" width="340" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;The family acts&lt;/b&gt;&lt;br&gt;a call, a neighbour's knock&lt;br&gt;Vela never knocks&lt;br&gt;auto-ask a contact only if opted in" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="1060" y="650" width="280" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Precision accounting&lt;/b&gt;&lt;br&gt;every notice records an outcome:&lt;br&gt;answered late · away · true concern · unknown&lt;br&gt;precision = true concern ÷ notices, published monthly" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;fontSize=11;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#1b2430;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="360" height="90" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c10" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c15" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7d8794;dashed=1;fontSize=10;fontColor=#7d8794;" edge="1" parent="1" source="c14" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#e0a23a;strokeWidth=2;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4a5566;fontSize=10;fontColor=#4a5566;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Step" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="200" height="24" as="geometry"/></mxCell><mxCell id="c30" value="When" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="780" width="260" height="24" as="geometry"/></mxCell><mxCell id="c31" value="What happens" style="whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;fillColor=#f6f7f9;strokeColor=#d9dee6;fontColor=#7d8794;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="780" width="860" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Arrival" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="804" width="200" height="36" as="geometry"/></mxCell><mxCell id="c33" value="member's arrival hour (default wake + 30 min; 08:00 for ordinary members)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="804" width="260" height="36" as="geometry"/></mxCell><mxCell id="c34" value="One message with the family's content and one reply affordance. Never more than one a day. Ordinary members get nothing on an empty day; kept-light members get the Vela fallback." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="804" width="860" height="36" as="geometry"/></mxCell><mxCell id="c35" value="Repeat" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="200" height="36" as="geometry"/></mxCell><mxCell id="c36" value="arrival + 2.5 h, no answer, kept-light only" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="840" width="260" height="36" as="geometry"/></mxCell><mxCell id="c37" value="The same arrival re-sent once with “in case you missed it”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="840" width="860" height="36" as="geometry"/></mxCell><mxCell id="c38" value="Quiet notice" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="200" height="49" as="geometry"/></mxCell><mxCell id="c39" value="arrival + T_quiet (5 h to start; then median latency + 2 h, floor 4 h, cap 8 h; Sunday median if it differs by &gt;1 h)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="876" width="260" height="49" as="geometry"/></mxCell><mxCell id="c40" value="Organiser gets: last contact, usual answer time, yesterday's summary, nearby contacts with Call and Ask to check, She's away, Wait 2 hours" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="876" width="860" height="49" as="geometry"/></mxCell><mxCell id="c41" value="Auto-ask (opt-in)" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="200" height="26" as="geometry"/></mxCell><mxCell id="c42" value="notice + T_auto, no organiser action" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="925" width="260" height="26" as="geometry"/></mxCell><mxCell id="c43" value="“Anna asked us to check on Mrs Ivanova; she hasn't answered today. Could you knock or call?” to the first consented contact" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="925" width="860" height="26" as="geometry"/></mxCell><mxCell id="c44" value="Resolution" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="951" width="200" height="36" as="geometry"/></mxCell><mxCell id="c45" value="any answer, or the organiser marks fine or away" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="951" width="260" height="36" as="geometry"/></mxCell><mxCell id="c46" value="Notice closes; everyone who was told is told it's fine; outcome recorded" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="951" width="860" height="36" as="geometry"/></mxCell><mxCell id="c47" value="Away mode" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="987" width="200" height="49" as="geometry"/></mxCell><mxCell id="c48" value="set by anyone; said in an answer (“until Sunday”, confirmed back); learned after three recurrences" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="987" width="260" height="49" as="geometry"/></mxCell><mxCell id="c49" value="Arrivals continue (people like them); repeats and notices do not; ends on the date or on any answer if “until I'm back”" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fillColor=#ffffff;strokeColor=#d9dee6;fontColor=#1b2430;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="987" width="860" height="49" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_3_States_and_consent" name="3.3 · States and consent"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Member states, flame states, and consent" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c2" value="State machines the app and the ladder follow. Consent is a product decision, not a checkbox." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#7d8794;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Flame state (kept-light member, per day)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b2430;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1300" height="24" as="geometry"/></mxCell><mxCell id="c4" value="Unlit&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;flame on, no answer yet, within her window&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#4a5566;fontColor=#1b2430;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="170" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Lit&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;answered today (any kind)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#fbf0d8;strokeColor=#e0a23a;strokeWidth=2;fontColor=#1b2430;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="170" height="60" 