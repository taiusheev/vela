{
  "name": "@vela/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema (the source of truth for the data model), migrations, and database clients.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "export-sql": "node scripts/export-sql.ts",
    "migrate": "node src/migrate.ts",
    "dev-db": "node scripts/dev-db.ts"
  },
  "dependencies": {
    "@vela/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
