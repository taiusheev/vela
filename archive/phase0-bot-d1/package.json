{
  "name": "vela-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create vela",
    "db:migrate": "wrangler d1 execute vela --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute vela --local --file=./schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
