{
  "expo": {
    "name": "Vela Light",
    "slug": "vela-light",
    "owner": "velatwn",
    "scheme": "velalight",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FBF7F0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "family.vela.light",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "family.vela.light",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      ["expo-image-picker", { "cameraPermission": false, "microphonePermission": false }],
      ["expo-notifications", { "defaultChannel": "daily" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9647168-c915-4fff-8064-e25b0f075b1f"
      }
    }
  }
}
