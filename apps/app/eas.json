      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "test_vEaLzCEodpsVbkdNXLSWzqyMDCQ"
      }
    },
    "trial": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_API_URL": "https://vela.vela-light.workers.dev",
        "EXPO_PUBLIC_TRIAL_ENGLISH": "true",
        "EXPO_PUBLIC_TRIAL_TARGET": "production"
      },
      "channel": "production"
