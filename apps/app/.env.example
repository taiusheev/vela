# Copy to .env.local (git ignores it). Without these the app shows its example day and no sign-in.
#
# Both values here are public: everything named EXPO_PUBLIC_ is compiled into the app bundle and
# ships to every phone that installs it. The Clerk *secret* key (sk_…) belongs in no file in this
# repository and in no variable on this page; only a Worker is ever given one, by you, at a prompt.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# The API this app talks to. http://localhost:8787 is the server `pnpm --filter @vela/worker api:dev`
# runs on this machine (infra/README.md, section 9a).
EXPO_PUBLIC_API_URL=http://localhost:8787
