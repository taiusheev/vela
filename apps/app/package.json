{
  "name": "@vela/app",
  "version": "0.0.0",
  "private": true,
  "description": "The family app: Today, Ask, Exchanges and the quiet notice, for the people who keep a light on.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start:staging": "node --env-file=.env.staging ../../node_modules/expo/bin/cli start --clear",
    "e2e:serve": "EXPO_PUBLIC_DEMO_MODE=true EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY= EXPO_PUBLIC_API_URL= expo start --web --port 8082",
    "e2e:demo": "maestro test --headless --screen-size 430x1600 -e APP_URL=http://localhost:8082 .maestro/demo",
    "typecheck": "tsc -p tsconfig.json",
    "i18n:extract": "lingui extract --clean",
    "i18n:review": "node scripts/i18n-review.mts",
    "test": "lingui check sync --clean && vitest run",
    "test:i18n:future": "lingui check missing --locale zh-TW --mode catalog && VELA_CHECK_TRANSLATIONS=1 vitest run src/i18n/catalog.test.ts"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.20.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo/metro-runtime": "~57.0.16",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@tanstack/react-query": "^5.103.2",
    "@vela/contracts": "workspace:*",
    "expo": "^57.0.24",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-modules-core": "~57.0.18",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.22",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "devDependencies": {
    "@babel/parser": "catalog:",
    "@lingui/babel-plugin-lingui-macro": "catalog:",
    "@lingui/cli": "catalog:",
    "@lingui/format-po": "catalog:",
    "@lingui/metro-transformer": "catalog:",
    "@types/node": "catalog:",
    "@vela/copy": "workspace:*",
    "pofile-ts": "catalog:",
    "vitest": "catalog:"
  }
}
