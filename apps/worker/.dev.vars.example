# Every secret the two Workers read, by name and with no value. Copy to `.dev.vars` for
# `wrangler dev` and fill it in there; `.dev.vars` is git-ignored and never committed. Both
# Workers' local sessions read this one file.
# In staging and production each is a secret of the Worker named below, set once per environment
# in that Worker's settings in the Cloudflare dashboard, or with
# `wrangler secret put <NAME> --env <staging|production>` (add `-c wrangler.admin.jsonc` for the
# admin Worker).

# Pilot Worker (`vela`): Telegram bot token from BotFather, `<bot id>:<secret>`.
TELEGRAM_BOT_TOKEN=
# Pilot Worker: the `secret_token` registered with setWebhook: 1-256 characters of A-Z a-z 0-9 _ -
# Written by scripts/telegram-setup.ts and echoed by Telegram on every webhook request.
TELEGRAM_WEBHOOK_SECRET=
# Pilot Worker and admin Worker (`vela-admin`, which translates a sent weekly read): Anthropic API key.
ANTHROPIC_API_KEY=
# Pilot Worker: Deepgram API key for speech-to-text.
DEEPGRAM_API_KEY=
# Pilot Worker: Healthchecks.io ping URL; reconcile pings it when it finishes.
HEALTHCHECKS_PING_URL=
# Pilot Worker: the founder's personal chat id with the bot. Leave it empty on a laptop, which then
# sends no admin messages; a deployed pilot Worker refuses to start without it.
ADMIN_CONVERSATION_ID=
# Admin Worker: Cloudflare Access team domain, e.g. vela.cloudflareaccess.com (no scheme, no path).
ACCESS_TEAM_DOMAIN=
# Admin Worker: the Audience (AUD) tag of the Access application that covers the admin Worker.
ACCESS_AUD=
