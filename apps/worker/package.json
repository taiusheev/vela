{
  "name": "@vela/worker",
  "version": "0.0.0",
  "private": true,
  "description": "The Cloudflare Worker: HTTP routes, webhooks, the member scheduler Durable Object, queue consumers, and cron.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:admin": "wrangler dev -c wrangler.admin.jsonc -c wrangler.jsonc",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "telegram:setup": "node scripts/telegram-setup.ts",
    "notices": "node scripts/generate-notices.ts",
    "cf-typegen": "wrangler types --include-runtime false"
  },
  "dependencies": {
    "@vela/adapters": "workspace:*",
    "@vela/ai": "workspace:*",
    "@vela/contracts": "workspace:*",
    "@vela/core": "workspace:*",
    "@vela/db": "workspace:*",
    "@vela/services": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
